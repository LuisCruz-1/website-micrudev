---
import CustomQuote from '../../components/CustomQuote.astro';
import Footer from '../../components/Footer.astro';
import PlanCards from '../../components/PlanCards.astro';
import PlanComparison from '../../components/PlanComparison.astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Planes de desarrollo web | Micrudev"
  description="Compara los planes de desarrollo web de Micrudev: landing page, sitio informativo y tienda en línea, con precios, alcances y condiciones claras."
>
  <main class="relative z-10 pb-24 pt-40">
    <div class="container mx-auto max-w-[1200px] px-6">
      <header class="mx-auto mb-14 max-w-[780px] text-center">
        <div class="mb-6 inline-flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">Planes de desarrollo web</span>
        </div>
        <h1 class="mb-6 text-5xl font-semibold tracking-tight text-white md:text-6xl">
          Un alcance claro para <span class="text-warm-gradient">cada etapa.</span>
        </h1>
        <p class="text-lg leading-relaxed text-[var(--color-muted)]">
          Compara inversión, tiempos y entregables antes de elegir. Cada plan tiene un alcance definido y una página con todas sus condiciones.
        </p>
      </header>

      <PlanCards />

      <div class="mt-20">
        <PlanComparison />
      </div>
    </div>
  </main>

  <CustomQuote />
  <Footer />
</Layout>
