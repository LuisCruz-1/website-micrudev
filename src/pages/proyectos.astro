---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import projectsData from '../data/projects.json';

const projects = projectsData;
---

<Layout title="Proyectos | Micrudev">
  <main class="pt-40 pb-24 px-6 min-h-screen">
    <div class="container mx-auto max-w-[1200px]">
      
      <!-- Header -->
      <div class="mb-20 text-center relative z-10">
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="w-2 h-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
          <span class="text-system text-[11px] text-[var(--color-amber)] font-mono uppercase tracking-wider">Nuestro Trabajo</span>
        </div>
        <h1 class="text-[40px] md:text-[64px] font-[600] leading-[1.1] text-white tracking-tight mb-6">
          Proyectos que <span class="text-warm-gradient">escalan.</span>
        </h1>
        <p class="text-[18px] font-[400] text-[var(--color-muted)] max-w-[640px] mx-auto tracking-[0.2px] leading-relaxed">
          Explora algunos de los sistemas, aplicaciones web y arquitecturas que hemos construido para llevar a nuestros clientes al siguiente nivel.
        </p>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
        {projects.map(p => (
          <div class="command-bar-mockup group overflow-hidden flex flex-col hover:border-[var(--color-coral)]/40 transition-all duration-500 hover:-translate-y-1">
            <!-- Project Image + Abstract Cover -->
            <div class="h-48 w-full bg-[var(--color-canvas)] border-b border-white/5 relative overflow-hidden flex items-center justify-center">
              <div class="absolute inset-0 opacity-40 bg-[radial-gradient(circle_at_top_right,var(--color-amber)_0%,transparent_50%)] z-10 pointer-events-none"></div>
              <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-[var(--color-canvas)] to-transparent z-10"></div>
              
              <img src={p.image} alt={p.title} class="w-full h-full object-cover opacity-50 group-hover:opacity-100 transition-all duration-500 group-hover:scale-105 transform" />
              
              <span class="absolute font-[600] text-7xl text-white/10 group-hover:text-white/0 transition-colors duration-500 tracking-tighter z-20 pointer-events-none">
                {p.title.substring(0,2).toUpperCase()}
              </span>
            </div>
            
            <!-- Content -->
            <div class="p-6 md:p-8 flex flex-col flex-grow">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-xl font-semibold text-white mb-1">{p.title}</h3>
                  <span class="font-mono text-[10px] text-[var(--color-coral)] uppercase tracking-wider">{p.type} • {p.date}</span>
                </div>
                {p.link && (
                  <a href={p.link} target="_blank" rel="noopener noreferrer" class="w-8 h-8 shrink-0 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[var(--color-muted)] hover:bg-[var(--color-coral)] hover:text-white transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                )}
              </div>
              
              <h4 class="text-[13px] font-medium text-white/90 mb-3 leading-snug">{p.subtitle}</h4>
              
              <p class="text-[var(--color-muted)] text-[14px] leading-relaxed mb-6 flex-grow line-clamp-4">
                {p.description}
              </p>
              
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mt-auto pt-5 border-t border-white/5">
                {p.tech.map(t => (
                  <span class="font-mono text-[9px] text-[var(--color-muted)] bg-black/40 px-2 py-1 rounded border border-white/5 uppercase tracking-wide">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</Layout>