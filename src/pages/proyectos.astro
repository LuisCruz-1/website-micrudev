---
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
---

<Layout
  title="Proyectos de desarrollo, IA y automatización | Micrudev"
  description="Conoce aplicaciones, plataformas e integraciones desarrolladas por Micrudev para resolver necesidades reales de operación y crecimiento."
>
  <main class="min-h-screen px-6 pb-24 pt-40">
    <div class="container mx-auto max-w-[1200px]">
      <header class="relative z-10 mx-auto mb-16 max-w-[760px] text-center md:mb-20">
        <div class="mb-6 inline-flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-amber)]">Nuestro trabajo</span>
        </div>
        <h1 class="mb-6 text-[40px] font-[600] leading-[1.08] tracking-tight text-white md:text-[64px]">
          Tecnología aplicada a <span class="text-warm-gradient">problemas reales.</span>
        </h1>
        <p class="mx-auto max-w-[670px] text-[18px] leading-relaxed tracking-[0.2px] text-[var(--color-muted)]">
          Cada proyecto parte de una necesidad distinta. Explora el contexto, el enfoque y las decisiones detrás de las soluciones que hemos construido.
        </p>
      </header>

      <div class="relative z-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
