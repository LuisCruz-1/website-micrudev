---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import TechStack from '../components/TechStack.astro';
import Pricing from '../components/Pricing.astro';
import CustomQuote from '../components/CustomQuote.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Micrudev | Desarrollo web, aplicaciones y automatización"
	description="Planes web en WordPress con alcance y precio definidos, además de aplicaciones, automatizaciones e integraciones de IA desarrolladas a medida."
>
	<main>
		<Hero />
		<Services />
		<ProjectsPreview />
		<TechStack />
		<Pricing />
		<CustomQuote />
	</main>
	<Footer />
</Layout>
