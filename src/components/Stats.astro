---
const stats = [
  { value: "99%", label: "Satisfacción de clientes" },
  { value: "50+", label: "Proyectos entregados" },
  { value: "2x", label: "Velocidad promedio" }
];
---

<section class="py-20 border-y border-white/10 bg-[var(--color-navy)]/30 backdrop-blur-md relative z-10">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      {stats.map((stat) => (
        <div class="flex flex-col relative group">
          <div class="absolute -inset-4 bg-[var(--color-blue-light)]/0 group-hover:bg-[var(--color-blue-light)]/5 rounded-2xl transition-colors duration-300"></div>
          <div class="text-5xl md:text-6xl font-mono font-bold text-white tracking-tight mb-3 group-hover:text-gradient transition-all duration-300">
            {stat.value}
          </div>
          <p class="text-[var(--color-muted)] text-sm font-heading uppercase tracking-wider">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
