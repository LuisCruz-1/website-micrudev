<section class="py-24 md:py-32 border-y border-white/10 relative overflow-hidden bg-void/50">
  <div class="container relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 text-center">
      
      <div class="group relative flex flex-col items-center">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-blue-primary blur-[60px] opacity-20 group-hover:opacity-40 transition-opacity duration-500 rounded-full pointer-events-none"></div>
        <div class="font-heading text-6xl md:text-7xl font-bold text-white mb-2 tracking-tight">
          99<span class="text-blue-primary">%</span>
        </div>
        <p class="font-mono text-sm tracking-widest text-muted uppercase">Satisfacción Cliente</p>
      </div>
      
      <div class="group relative flex flex-col items-center">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-blue-tertiary blur-[60px] opacity-20 group-hover:opacity-40 transition-opacity duration-500 rounded-full pointer-events-none"></div>
        <div class="font-heading text-6xl md:text-7xl font-bold text-white mb-2 tracking-tight flex items-start justify-center">
          <span class="text-blue-tertiary text-4xl mt-2">+</span>50
        </div>
        <p class="font-mono text-sm tracking-widest text-muted uppercase">Nodos Desplegados</p>
      </div>
      
      <div class="group relative flex flex-col items-center">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-blue-secondary blur-[60px] opacity-20 group-hover:opacity-40 transition-opacity duration-500 rounded-full pointer-events-none"></div>
        <div class="font-heading text-6xl md:text-7xl font-bold text-white mb-2 tracking-tight">
          2<span class="text-blue-secondary">x</span>
        </div>
        <p class="font-mono text-sm tracking-widest text-muted uppercase">Velocidad Promedio</p>
      </div>
      
    </div>
  </div>
</section>
