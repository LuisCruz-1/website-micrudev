---
import PlanCards from './PlanCards.astro';
---

<section id="precios" class="relative z-10 border-t border-white/5 py-24 scroll-mt-20">
  <div class="container mx-auto max-w-[1200px] px-6">
    <div class="mx-auto mb-14 max-w-[720px] text-center">
      <div class="mb-6 inline-flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">Planes de desarrollo web</span>
      </div>
      <h2 class="mb-6 text-4xl font-[600] tracking-tight text-white md:text-5xl">
        Elige el nivel que tu negocio <span class="text-warm-gradient">necesita hoy.</span>
      </h2>
      <p class="text-lg leading-relaxed text-[var(--color-muted)]">
        Tres alcances definidos e inversión transparente. Revisa el resumen aquí o consulta todos los detalles en la página de planes.
      </p>
    </div>

    <PlanCards />

    <div class="mt-12 text-center">
      <a href="/planes" class="keycap-btn">
        Comparar todos los planes
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</section>
