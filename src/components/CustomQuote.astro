---
import { getWhatsAppUrl } from '../lib/contact';

const customProjectUrl = getWhatsAppUrl('Hola Micrudev, tengo un proyecto a medida y quisiera realizar un diagnóstico inicial de mis requerimientos.');
---

<section id="contacto" class="relative z-10 scroll-mt-24 border-t border-white/5 py-12 md:py-16">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="contact-panel relative overflow-hidden rounded-[18px] border border-white/10 p-5 sm:p-7 md:grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-10 md:p-8">
      <div class="pointer-events-none absolute -left-20 -top-24 h-64 w-64 rounded-full bg-[var(--color-coral)]/12 blur-[90px]"></div>
      <div class="relative">
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-amber)]">Proyecto a medida</span>
        <h2 class="mt-2 max-w-[700px] text-[32px] font-semibold leading-[1.06] tracking-[-0.035em] text-white md:text-[40px]">
          Cuéntanos el problema. Nosotros te ayudamos a definir <span class="text-warm-gradient">el siguiente paso.</span>
        </h2>
        <p class="mt-4 max-w-[650px] text-[14px] leading-[1.7] text-[var(--color-muted)] md:text-[15px]">Revisamos tu objetivo, proceso actual e integraciones necesarias antes de preparar una propuesta.</p>
      </div>

      <div class="relative mt-7 flex flex-col gap-3 md:mt-0 md:min-w-[220px]">
        <a href={customProjectUrl} target="_blank" rel="noopener noreferrer" class="keycap-btn min-h-12 justify-center !px-6">
          Hablar del proyecto
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="mailto:hola@micrudev.com" class="inline-flex min-h-11 items-center justify-center rounded-lg text-sm text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">hola@micrudev.com</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    background: color-mix(in srgb, var(--theme-cmd-bg) 94%, transparent);
    box-shadow: 0 30px 90px color-mix(in srgb, var(--color-coral) 10%, transparent), var(--theme-cmd-shadow);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }
</style>
