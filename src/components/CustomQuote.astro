<section id="contacto" class="py-24 relative z-10 border-t border-white/5">
  <div class="container mx-auto px-6 max-w-[1000px]">
    <div class="command-bar-mockup p-10 md:p-16 text-center relative overflow-hidden">
      <!-- Glow effect behind content -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60%] h-[60%] bg-[var(--color-coral)]/10 blur-[100px] rounded-full pointer-events-none"></div>
      
      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 mb-6">
          <span class="w-2 h-2 rounded-full bg-[var(--color-blue-400)] animate-pulse"></span>
          <span class="font-mono text-[11px] text-[var(--color-muted)] uppercase tracking-wider">Auditoría Gratuita</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl font-[600] text-white tracking-tight mb-6">
          ¿Necesitas un sistema <span class="text-warm-gradient">a medida?</span>
        </h2>
        
        <p class="text-[var(--color-muted)] text-lg max-w-[600px] mx-auto mb-10 leading-relaxed">
          Para aplicaciones web complejas, automatizaciones empresariales o integraciones de IA, realizamos un análisis profundo de tus requerimientos operativos antes de cotizar.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a href="mailto:hola@micrudev.com" class="keycap-btn !px-8 !py-4 !text-base">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Agendar llamada técnica
          </a>
          <a href="mailto:hola@micrudev.com" class="ghost-pill !px-6 !py-3.5">
            hola@micrudev.com
          </a>
        </div>
      </div>
    </div>
  </div>
</section>