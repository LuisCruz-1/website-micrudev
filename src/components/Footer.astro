---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
---

<footer class="py-12 border-t border-white/5 relative z-10 bg-[var(--color-canvas)]">
  <div class="container mx-auto px-6 max-w-[1200px]">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-3">
        <img src={logoWhite.src} alt="Micrudev Logo" class="h-6 opacity-80 hidden dark:block" />
        <img src={logoPrimary.src} alt="Micrudev Logo" class="h-6 opacity-80 block dark:hidden" />
      </div>

      <div class="flex gap-8 font-mono text-[11px] text-[var(--color-muted)] uppercase tracking-wider">
        <a href="/#servicios" class="hover:text-white transition-colors">/ Servicios</a>
        <a href="/#stack" class="hover:text-white transition-colors">/ Stack</a>
        <a href="/#precios" class="hover:text-white transition-colors">/ Precios</a>
        <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-coral)] transition-colors">/ Contacto</a>
      </div>

      <p class="font-mono text-[11px] text-[var(--color-muted)] uppercase tracking-wider">
        © {new Date().getFullYear()} MICRUDEV. ALL RIGHTS RESERVED.
      </p>
    </div>
  </div>
</footer>
