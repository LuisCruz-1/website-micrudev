---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
---

<footer class="relative z-10 border-t border-white/5 py-10">
  <div class="container mx-auto max-w-[1200px] px-6">
    <div class="flex flex-col items-center justify-between gap-7 lg:flex-row">
      <a href="/" class="flex items-center gap-3 rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
        <img src={logoWhite.src} alt="" class="hidden h-6 opacity-80 dark:block" />
        <img src={logoPrimary.src} alt="" class="block h-6 opacity-80 dark:hidden" />
      </a>

      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3 font-mono text-[10px] uppercase tracking-wider text-[var(--color-muted)]" aria-label="Navegación secundaria">
        <a href="/#servicios" class="transition-colors hover:text-white">/ Servicios</a>
        <a href="/proyectos" class="transition-colors hover:text-white">/ Proyectos</a>
        <a href="/planes" class="transition-colors hover:text-white">/ Planes</a>
        <a href="/#stack" class="transition-colors hover:text-white">/ Stack</a>
        <a href="/#contacto" class="transition-colors hover:text-[var(--color-amber)]">/ Contacto</a>
      </nav>

      <p class="text-center font-mono text-[10px] uppercase tracking-wider text-[var(--color-muted)]">
        © {new Date().getFullYear()} Micrudev. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
