---

<footer class="bg-void border-t border-white/10 pt-24 pb-8 relative overflow-hidden">
  <!-- Decorative background blur -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[800px] h-[300px] bg-blue-primary opacity-10 blur-[120px] rounded-full pointer-events-none z-0"></div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <div class="md:col-span-6 lg:col-span-5">
        <img src="/logos/Micrudev_Logo_Primary_White_BG.png" alt="Micrudev Logo" class="h-8 brightness-0 invert mb-6" />
        <p class="font-heading text-xl font-semibold text-white mb-4 tracking-tight">Tecnología que simplifica.</p>
        <p class="text-muted leading-relaxed max-w-sm">
          Arquitectura digital de precisión. Desarrollamos plataformas escalables, rápidas y seguras para el ecosistema moderno.
        </p>
      </div>

      <div class="md:col-span-3 lg:col-span-3 lg:col-start-7">
        <h4 class="font-mono text-sm tracking-widest text-white mb-6 uppercase">Infraestructura</h4>
        <ul class="flex flex-col gap-4">
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Desarrollo Web</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Diseño UI/UX</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Sistemas a Medida</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Consultoría</a></li>
        </ul>
      </div>

      <div class="md:col-span-3 lg:col-span-3">
        <h4 class="font-mono text-sm tracking-widest text-white mb-6 uppercase">Red</h4>
        <ul class="flex flex-col gap-4">
          <li><a href="mailto:hola@micrudev.com" class="text-muted hover:text-blue-primary transition-colors duration-200">hola@micrudev.com</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Agendar Llamada</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">LinkedIn</a></li>
          <li><a href="#" class="text-muted hover:text-blue-primary transition-colors duration-200">Instagram</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center pt-8 border-t border-white/10 gap-4">
      <p class="text-muted text-sm font-mono">
        &copy; {new Date().getFullYear()} MICRUDEV. SISTEMA ACTIVO.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-muted hover:text-white text-sm transition-colors">Privacidad</a>
        <a href="#" class="text-muted hover:text-white text-sm transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>
