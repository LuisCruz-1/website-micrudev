---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
import { isNavigationItemCurrent, navigationItems } from '../lib/navigation';

const pathname = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const footerItems = navigationItems.map((item) => ({
  ...item,
  current: isNavigationItemCurrent(item, pathname),
}));
---

<footer class="relative z-10 border-t border-white/5 py-12 md:py-14">
  <div class="container mx-auto max-w-[1200px] px-6">
    <div class="grid gap-8 border-b border-white/8 pb-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center rounded px-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
          <img src={logoWhite.src} alt="" class="hidden h-6 dark:block" />
          <img src={logoPrimary.src} alt="" class="block h-6 dark:hidden" />
        </a>
        <p class="mt-3 max-w-[500px] text-sm leading-relaxed text-[var(--color-muted)] md:text-[15px]">
          Sitios web y software a medida para simplificar procesos, conectar herramientas y hacer avanzar tu negocio.
        </p>
      </div>

      <div class="md:text-right">
        <span class="mb-1 block font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Contacto directo</span>
        <a href="mailto:hola@micrudev.com" class="group inline-flex min-h-11 items-center gap-2 rounded text-sm font-medium text-white transition-colors hover:text-[var(--color-amber)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
          hola@micrudev.com
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></svg>
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-6 pt-6 lg:flex-row lg:items-center lg:justify-between">
      <nav class="grid grid-cols-2 gap-x-4 sm:flex sm:flex-wrap sm:items-center sm:gap-x-6" aria-label="Navegación secundaria">
        {footerItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              'footer-link inline-flex min-h-11 items-center gap-1.5 rounded font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-amber)]',
              { 'footer-link--active': item.current },
            ]}
          >
            <span class="route-mark" aria-hidden="true">/</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center justify-between gap-5 border-t border-white/5 pt-5 lg:border-0 lg:pt-0">
        <p class="font-mono text-[9px] uppercase leading-relaxed tracking-[0.11em] text-[var(--color-muted)]">
          © {currentYear} Micrudev
        </p>
        <a href="#contenido-principal" class="group inline-flex min-h-11 items-center gap-2 rounded font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
          Volver arriba
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-y-0.5" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link .route-mark {
    color: color-mix(in srgb, var(--color-coral) 70%, var(--color-muted));
    transition: color 180ms ease;
  }

  .footer-link--active {
    color: var(--color-white);
  }

  .footer-link--active .route-mark {
    color: var(--color-amber);
  }
</style>
