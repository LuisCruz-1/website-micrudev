---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
import { isNavigationItemCurrent, navigationItems } from '../lib/navigation';

const pathname = Astro.url.pathname;
const currentYear = new Date().getFullYear();
const footerItems = navigationItems.map((item) => ({
  ...item,
  displayHref: pathname === '/' && item.homeHref ? item.homeHref : item.href,
  current: isNavigationItemCurrent(item, pathname),
}));
---

<footer class="relative z-10 border-t border-white/8 pb-7 pt-10 md:pb-9 md:pt-14">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center rounded focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
          <img src={logoWhite.src} alt="" class="hidden h-6 dark:block" />
          <img src={logoPrimary.src} alt="" class="block h-6 dark:hidden" />
        </a>
        <p class="mt-3 max-w-[520px] text-[18px] font-medium leading-[1.45] tracking-[-0.018em] text-white md:text-[21px]">
          Sitios web y software a medida para hacer más simple el trabajo de tu negocio.
        </p>
      </div>

      <div class="md:text-right">
        <span class="block font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Contacto</span>
        <a href="mailto:hola@micrudev.com" class="group mt-1 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-white transition-colors hover:text-[var(--color-amber)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
          hola@micrudev.com
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
        </a>
        <p class="text-xs text-[var(--color-muted)]">Cuenca, Ecuador · Trabajo remoto</p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-y border-white/8 py-3 sm:flex-row sm:items-center sm:justify-between md:mt-10">
      <nav class="flex flex-wrap gap-x-6" aria-label="Navegación secundaria">
        {footerItems.map((item) => (
          <a href={item.displayHref} aria-current={item.current ? 'page' : undefined} class:list={['footer-link inline-flex min-h-10 items-center text-[13px] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]', { 'footer-link--active': item.current }] }>
            {item.label}
          </a>
        ))}
      </nav>

      <a href="#contenido-principal" class="group inline-flex min-h-10 items-center gap-2 self-start rounded font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)] sm:self-auto">
        Volver arriba
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:-translate-y-0.5" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
      </a>
    </div>

    <div class="mt-5 flex flex-col gap-2 font-mono text-[9px] uppercase tracking-[0.11em] text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} Micrudev</p>
      <p>Sitios web · Software a medida</p>
    </div>
  </div>
</footer>

<style>
  .footer-link--active {
    color: var(--color-white);
  }
</style>
