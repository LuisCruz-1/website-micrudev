---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
---

<div class="relative min-h-screen flex flex-col items-center pt-40 pb-16 px-6">
  
  <!-- Eyebrow -->
  <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 mb-8 shadow-sm mt-8 relative overflow-hidden group">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[var(--color-blue-400)]/10 to-transparent -translate-x-full animate-[shimmer_2.5s_infinite]"></div>
    <span class="w-2 h-2 rounded-full bg-[var(--color-blue-400)] animate-pulse"></span>
    <span class="font-mono text-[11px] text-white uppercase tracking-wider">Tecnología que simplifica.</span>
  </div>

  <!-- Headline -->
  <h1 class="text-[40px] md:text-[64px] font-[600] leading-[1.1] text-white text-center max-w-[800px] tracking-tight">
    Todo tu ecosistema digital,<br />
    <span class="text-warm-gradient">a un clic</span> de distancia.
  </h1>

  <!-- Subtitle -->
  <p class="text-[18px] font-[400] text-[var(--color-muted)] text-center max-w-[640px] mt-6 tracking-[0.2px] leading-relaxed">
    Una agencia de desarrollo diseñada para eliminar la fricción. Sitios web ultrarrápidos, aplicaciones a medida y automatizaciones inteligentes.
  </p>

  <!-- Keycap Buttons Row -->
  <div class="flex flex-col sm:flex-row gap-4 mt-10">
    <a href="#precios" class="keycap-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      Ver Planes Web
    </a>
    <a href="#contacto" class="keycap-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      Solicitar Auditoría
    </a>
  </div>

  <!-- Install Caption -->
  <p class="font-mono text-[12px] text-[var(--color-muted)] mt-5 tracking-wide">
    npx create-micrudev-app@latest - inicia tu proyecto hoy
  </p>

  <!-- Command Bar Mockup -->
  <div class="command-bar-mockup w-full max-w-[680px] mt-16 flex flex-col text-left overflow-hidden">
    <!-- Top Row: Input -->
    <div class="flex items-center px-4 py-4 border-b border-white/5">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <span class="text-white text-lg font-medium flex items-center">
        iniciar proyecto <span class="w-[2px] h-6 bg-[var(--color-coral)] ml-1 animate-pulse"></span>
      </span>
      <div class="ml-auto bg-white/5 border border-white/10 px-2 py-1 rounded text-[11px] text-[var(--color-muted)] font-medium uppercase tracking-wider">
        Micrudev CLI
      </div>
    </div>
    
    <!-- Result Rows -->
    <div class="flex flex-col py-2">
      <!-- Active Row -->
      <div class="flex items-center justify-between px-4 py-3 bg-[var(--color-crimson)]/15 border-l-2 border-[var(--color-crimson)] cursor-pointer">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" x2="12" y1="22" y2="12"/></svg>
          <span class="text-white text-[15px] font-medium">Desarrollo Web</span>
          <span class="font-mono text-[13px] text-[var(--color-coral)]/80 ml-2">--template astro</span>
        </div>
        <div class="font-mono text-[11px] text-[var(--color-muted)] bg-black/40 px-1.5 py-0.5 rounded border border-white/5">
          Cmd+W
        </div>
      </div>
      
      <!-- Inactive Row 1 -->
      <div class="flex items-center justify-between px-4 py-3 hover:bg-white/5 cursor-pointer transition-colors border-l-2 border-transparent">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span class="text-[var(--color-muted)] text-[15px]">Aplicaciones Web</span>
          <span class="font-mono text-[13px] text-[var(--color-muted)]/50 ml-2">pnpm build --saas</span>
        </div>
        <div class="font-mono text-[11px] text-[var(--color-muted)]/60 bg-white/5 px-1.5 py-0.5 rounded border border-white/5">
          Cmd+A
        </div>
      </div>

      <!-- Inactive Row 2 -->
      <div class="flex items-center justify-between px-4 py-3 hover:bg-white/5 cursor-pointer transition-colors border-l-2 border-transparent">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span class="text-[var(--color-muted)] text-[15px]">Automatizaciones</span>
          <span class="font-mono text-[13px] text-[var(--color-muted)]/50 ml-2">--zapier --make</span>
        </div>
        <div class="font-mono text-[11px] text-[var(--color-muted)]/60 bg-white/5 px-1.5 py-0.5 rounded border border-white/5">
          Cmd+Z
        </div>
      </div>
      
      <!-- Inactive Row 3 -->
      <div class="flex items-center justify-between px-4 py-3 hover:bg-white/5 cursor-pointer transition-colors border-l-2 border-transparent">
        <div class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
          <span class="text-[var(--color-muted)] text-[15px]">Auditoría Técnica</span>
        </div>
        <div class="font-mono text-[11px] text-[var(--color-muted)]/60 bg-white/5 px-1.5 py-0.5 rounded border border-white/5">
          Cmd+K
        </div>
      </div>
    </div>

    <!-- Footer Hints -->
    <div class="bg-black/30 px-4 py-2 border-t border-white/5 flex items-center justify-between">
      <span class="font-mono text-[11px] text-[var(--color-muted)]/70">
        navegar ↑/↓ - entrar ↵ - cerrar esc
      </span>
      <div class="flex items-center gap-1.5 opacity-40">
        <img src={logoWhite.src} alt="Micrudev Logo" class="h-3 opacity-50" />
      </div>
    </div>
  </div>

  <!-- Ghost Pill -->
  <a href="#servicios" class="ghost-pill mt-12 group">
    Explorar servicios 
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-y-1"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
  </a>

  <!-- Floating Badge -->
  <div class="fixed bottom-6 right-6 bg-black/60 backdrop-blur-md border border-white/10 rounded-xl px-4 py-3 flex items-center gap-3 shadow-2xl z-50">
    <div class="w-8 h-8 rounded-full bg-[var(--color-blue)] flex items-center justify-center">
      <img src={logoWhite.src} alt="Micrudev Logo" class="h-4" />
    </div>
    <div class="flex flex-col">
      <span class="text-[10px] text-[var(--color-muted)] font-medium uppercase tracking-wide">Agencia de</span>
      <span class="text-[13px] font-bold text-white leading-tight">Desarrollo Top</span>
    </div>
  </div>

</div>