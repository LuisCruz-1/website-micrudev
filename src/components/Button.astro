---
interface Props {
  text: string;
  variant?: 'primary' | 'outline' | 'ghost';
  href?: string;
  class?: string;
  icon?: boolean;
}

const { text, variant = 'primary', href, class: className = '', icon = false } = Astro.props;

const Element = href ? 'a' : 'button';

const baseStyles = "inline-flex items-center justify-center font-body font-bold rounded-full transition-all duration-300 gap-2 px-7 py-3.5 text-sm";

const variants = {
  primary: "bg-[var(--color-blue)] text-white glow-shadow hover:bg-[var(--color-white)] hover:text-[var(--color-navy)] hover:-translate-y-0.5",
  outline: "glass-panel text-white hover:border-[var(--color-blue)] hover:text-[var(--color-blue-light)] hover:-translate-y-0.5",
  ghost: "bg-transparent text-white/70 hover:text-white"
};

const iconClass = "transition-transform duration-200 group-hover:translate-x-1";
---

<Element href={href} class={`${baseStyles} ${variants[variant]} group ${className}`}>
  {text}
  {icon && (
    <span class={iconClass}>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </span>
  )}
</Element>
