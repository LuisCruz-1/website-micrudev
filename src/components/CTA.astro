---
import Button from './Button.astro';
---

<section class="py-32 relative z-10 overflow-hidden" id="contacto">
  <!-- Giant Background Glow for CTA -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80vw] max-w-[800px] aspect-square rounded-full bg-[var(--color-blue)]/20 blur-[150px] pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="max-w-4xl mx-auto text-center glass-card rounded-[3rem] p-12 md:p-24 border border-[var(--color-blue-light)]/20">
      <div class="inline-flex items-center gap-2 mb-8 glass-panel px-4 py-2 rounded-full">
        <span class="w-2 h-2 rounded-full bg-[var(--color-blue-light)] animate-pulse"></span>
        <span class="text-system text-[10px] text-[var(--color-blue-light)]">INIT_SEQUENCE</span>
      </div>
      
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-heading font-bold leading-[0.95] tracking-tighter text-white mb-8">
        ¿Listo para <span class="text-gradient">empezar?</span>
      </h2>
      
      <p class="text-xl text-[var(--color-muted)] leading-relaxed max-w-2xl mx-auto mb-12">
        Cuéntanos tu idea. Te respondemos en menos de 24 horas con una propuesta técnica clara y sin compromiso.
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="keycap-btn">
            Iniciar proyecto
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="mailto:hola@micrudev.com" class="ghost-pill">
            hola@micrudev.com
          </a>
        </div>
    </div>
  </div>
</section>
