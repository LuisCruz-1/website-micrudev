---
const services = [
  {
    id: '01',
    mode: 'Plan definido',
    title: 'Desarrollo Web',
    desc: 'Landing pages, sitios corporativos y tiendas en WordPress con alcance, tiempos y precios establecidos desde el inicio.',
    href: '/planes',
    action: 'Ver planes web',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
  },
  {
    id: '02',
    mode: 'A medida',
    title: 'Aplicaciones Web',
    desc: 'CRMs, plataformas y herramientas internas diseñadas alrededor de la operación diaria de tu organización.',
    href: '#contacto',
    action: 'Evaluar proyecto',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 15h18"/><path d="M15 3v18"/></svg>`,
  },
  {
    id: '03',
    mode: 'A medida',
    title: 'Automatizaciones',
    desc: 'Conexión de herramientas y flujos empresariales para reducir tareas repetitivas y errores manuales.',
    href: '#contacto',
    action: 'Evaluar proyecto',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m17 19-5 3-5-3"/><path d="M2 12h20"/><path d="m5 7 3 5-3 5"/><path d="m19 7-3 5 3 5"/></svg>`,
  },
  {
    id: '04',
    mode: 'A medida',
    title: 'Integraciones de IA',
    desc: 'Asistentes, chatbots y funciones inteligentes conectadas con la información y los sistemas de tu negocio.',
    href: '#contacto',
    action: 'Evaluar proyecto',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>`,
  },
];
---

<section id="servicios" class="relative z-10 scroll-mt-20 border-t border-white/5 py-24">
  <div class="container mx-auto max-w-[1000px] px-6">
    <div class="mb-14 text-center">
      <div class="mb-6 inline-flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
        <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-muted)]">Servicios</span>
      </div>
      <h2 class="mb-6 text-4xl font-[600] tracking-tight text-white md:text-5xl">
        Dos formas de <span class="text-warm-gradient">construir.</span>
      </h2>
      <p class="mx-auto max-w-[650px] text-lg leading-relaxed text-[var(--color-muted)]">
        Elige un plan cerrado para tu sitio web o definimos una solución específica para tus procesos.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {services.map((service) => (
        <article class="command-bar-mockup group flex flex-col p-7 transition-colors hover:border-[var(--color-coral)]/30 md:p-8">
          <div class="mb-6 flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-white/10 bg-[var(--color-canvas)] text-[var(--color-amber)] transition-colors group-hover:text-[var(--color-coral)]">
              <Fragment set:html={service.icon} />
            </div>
            <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)]">{service.id} / {service.mode}</span>
          </div>
          <h3 class="mb-3 text-xl font-semibold text-white">{service.title}</h3>
          <p class="mb-7 flex-grow leading-relaxed text-[var(--color-muted)]">{service.desc}</p>
          <a href={service.href} class="inline-flex items-center gap-2 font-mono text-[12px] text-[var(--color-muted)] transition-colors hover:text-white">
            {service.action}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
