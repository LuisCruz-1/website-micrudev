---
import { getFeaturedProjects, getProjectImageSrc } from '../lib/projects';

const featuredProjects = await getFeaturedProjects();
const [leadProject, ...secondaryProjects] = featuredProjects;
---

<section id="projects-preview" class="relative z-10 scroll-mt-24 border-t border-white/5 py-12 md:py-16">
  <div class="mx-auto max-w-[1120px] px-6">
    <header class="mb-6 grid gap-4 md:grid-cols-[minmax(0,0.8fr)_minmax(300px,0.45fr)] md:items-end md:justify-between md:gap-10">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-amber)]">Proyectos</span>
        <h2 class="mt-2 max-w-[680px] text-[34px] font-semibold leading-[1.06] tracking-[-0.035em] text-white md:text-[44px]">
          Soluciones construidas para <span class="text-warm-gradient">problemas reales.</span>
        </h2>
      </div>
      <div class="md:pb-1">
        <p class="text-[15px] leading-[1.75] text-[var(--color-muted)]">
          Conoce las decisiones, conexiones y resultados detrás de aplicaciones que ya operan en contextos reales.
        </p>
        <a href="/proyectos" class="group mt-5 inline-flex min-h-11 items-center gap-3 rounded text-sm font-medium text-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-amber)]">
          Explorar todos los casos
          <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 text-[var(--color-muted)] transition-all group-hover:border-[var(--color-coral)]/40 group-hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </span>
        </a>
      </div>
    </header>

    {leadProject && (
      <div class="project-showcase grid gap-3 lg:grid-cols-[minmax(0,1.42fr)_minmax(320px,0.58fr)]">
        <a href={`/proyectos/${leadProject.id}`} class="lead-project group relative min-h-[350px] overflow-hidden rounded-[18px] border border-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)] md:min-h-[430px]" aria-label={`Ver proyecto ${leadProject.data.title}`}>
          <img src={getProjectImageSrc(leadProject.data.image)} alt={leadProject.data.imageAlt} class="lead-project__image absolute inset-0 h-full w-full object-cover" loading="lazy" />
          <div class="lead-project__veil absolute inset-0"></div>

          <div class="absolute inset-x-0 top-0 flex items-start justify-between gap-4 p-5 md:p-7">
            <span class="rounded-md border border-[#fff]/15 bg-[#040B1F]/75 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.13em] text-[#fff] backdrop-blur-md">Proyecto destacado</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-[#fff]/70">{leadProject.data.year}</span>
          </div>

          <div class="project-copy absolute inset-x-0 bottom-0 p-5 md:p-8">
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <span class="font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-amber)]">{leadProject.data.client}</span>
              <span class="h-1 w-1 rounded-full bg-[#fff]/35"></span>
              <span class="font-mono text-[9px] uppercase tracking-[0.15em] text-[#fff]/65">{leadProject.data.type}</span>
            </div>
            <div class="grid items-end gap-5 md:grid-cols-[minmax(0,1fr)_auto]">
              <div>
                <h3 class="text-[32px] font-semibold leading-none tracking-[-0.035em] text-[#fff] md:text-[40px]">{leadProject.data.title}</h3>
                <p class="mt-4 max-w-[650px] text-sm leading-relaxed text-[#fff]/75 md:text-base">{leadProject.data.subtitle}</p>
              </div>
              <span class="flex h-12 w-12 items-center justify-center rounded-full border border-[#fff]/20 bg-[#040B1F]/40 text-[#fff] backdrop-blur-md transition-all group-hover:scale-105 group-hover:border-[var(--color-amber)] group-hover:bg-[var(--color-coral)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              </span>
            </div>
          </div>
        </a>

        <div class="hidden gap-3 sm:grid sm:grid-cols-2 lg:grid-cols-1">
          {secondaryProjects.map((project) => (
            <a href={`/proyectos/${project.id}`} class="secondary-project group relative min-h-[225px] overflow-hidden rounded-[18px] border border-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]" aria-label={`Ver proyecto ${project.data.title}`}>
              <img src={getProjectImageSrc(project.data.image)} alt={project.data.imageAlt} class="secondary-project__image absolute inset-0 h-full w-full object-cover" loading="lazy" />
              <div class="secondary-project__veil absolute inset-0"></div>
              <div class="absolute inset-x-0 top-0 flex justify-between gap-4 p-5 font-mono text-[9px] uppercase tracking-[0.13em] text-[#fff]/70">
                <span>{project.data.type}</span>
                <span>{project.data.year}</span>
              </div>
              <div class="project-copy absolute inset-x-0 bottom-0 p-5">
                <span class="mb-2 block font-mono text-[9px] uppercase tracking-[0.13em] text-[var(--color-amber)]">{project.data.client}</span>
                <div class="flex items-end justify-between gap-4">
                  <div>
                    <h3 class="text-[18px] font-semibold leading-[1.1] tracking-[-0.02em] text-[#fff]">{project.data.title}</h3>
                    <p class="mt-2 line-clamp-2 text-[12px] leading-[1.55] text-[#fff]/80">{project.data.subtitle}</p>
                  </div>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#fff]/20 bg-[#040B1F]/35 text-[#fff] backdrop-blur-md transition-all group-hover:border-[var(--color-amber)] group-hover:bg-[var(--color-coral)]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  .lead-project__image,
  .secondary-project__image {
    filter: saturate(0.72);
    transform: scale(1.01);
    transition: filter 500ms ease, transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lead-project__veil {
    background: linear-gradient(180deg, rgba(4, 11, 31, 0.16) 12%, rgba(4, 11, 31, 0.32) 42%, rgba(4, 11, 31, 0.82) 72%, rgba(4, 11, 31, 0.99) 100%);
  }

  .secondary-project__veil {
    background: linear-gradient(180deg, rgba(4, 11, 31, 0.24) 0%, rgba(4, 11, 31, 0.5) 0%, rgba(4, 11, 31, 0.94) 74%, rgba(4, 11, 31, 0.99) 100%);
  }

  .project-copy {
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.72);
  }

  .lead-project,
  .secondary-project {
    box-shadow: 0 30px 80px rgba(2, 8, 28, 0.24);
    transition: border-color 240ms ease, transform 240ms ease;
  }

  .lead-project:hover,
  .secondary-project:hover {
    border-color: color-mix(in srgb, var(--color-coral) 50%, transparent);
    transform: translateY(-3px);
  }

  .lead-project:hover .lead-project__image,
  .secondary-project:hover .secondary-project__image {
    filter: saturate(1);
    transform: scale(1.045);
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-project,
    .secondary-project,
    .lead-project__image,
    .secondary-project__image,
    .lead-project *,
    .secondary-project * {
      transition: none;
    }

    .lead-project:hover,
    .secondary-project:hover,
    .lead-project:hover .lead-project__image,
    .secondary-project:hover .secondary-project__image {
      transform: none;
    }
  }
</style>
