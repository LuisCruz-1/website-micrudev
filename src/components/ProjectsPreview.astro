---
import ProjectCard from './ProjectCard.astro';
import { getFeaturedProjects } from '../lib/projects';

const featuredProjects = await getFeaturedProjects();
---

<section id="projects-preview" class="relative z-10 border-t border-white/5 py-24">
  <div class="container mx-auto max-w-[1200px] px-6">
    <div class="mb-14 text-center">
      <div class="mb-6 inline-flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-muted)]">Trabajo seleccionado</span>
      </div>
      <h2 class="mb-5 text-4xl font-[600] tracking-tight text-white md:text-5xl">
        Proyectos con <span class="text-warm-gradient">problemas reales.</span>
      </h2>
      <p class="mx-auto max-w-[620px] text-lg leading-relaxed text-[var(--color-muted)]">
        Aplicaciones, automatizaciones e integraciones construidas alrededor de la operación de cada organización.
      </p>
    </div>

    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} compact />)}
    </div>

    <div class="flex justify-center">
      <a href="/proyectos" class="ghost-pill group !px-6 !py-3">
        Ver todos los proyectos
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    </div>
  </div>
</section>
