---
import type { Plan } from '../lib/plans';
import { formatUsd, getPlanInquiryUrl, getPlans } from '../lib/plans';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const { data } = plan;
const initialPayment = data.price / 2;
const inquiryUrl = getPlanInquiryUrl(data.name, data.price);
const otherPlans = (await getPlans()).filter((entry) => entry.id !== plan.id);
const planCode = `WEB-${String(data.order).padStart(2, '0')}`;
---

<main class="relative z-10 min-h-screen pb-16 pt-32 md:pt-36">
  <div class="container mx-auto max-w-[1100px] px-6">
    <a href="/planes" class="mb-5 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      Volver a todos los planes
    </a>

    <header class="command-bar-mockup relative mb-5 overflow-hidden" aria-labelledby="plan-title">
      <div class="pointer-events-none absolute -right-24 -top-28 h-80 w-80 rounded-full bg-[var(--color-coral)]/15 blur-[90px]"></div>

      <div class="relative grid lg:grid-cols-[minmax(0,1fr)_330px]">
        <div class="p-6 sm:p-8 lg:p-10">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-[var(--color-coral)]/25 bg-[var(--color-coral)]/10 px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-amber)]">{data.level}</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)]">{planCode} · {data.modality}</span>
            {data.featured && <span class="font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-coral)]">Más elegido</span>}
          </div>
          <h1 id="plan-title" class="mb-4 max-w-[680px] text-[38px] font-semibold leading-[1.04] tracking-[-0.04em] text-white sm:text-[46px] lg:text-[52px]">{data.title}</h1>
          <p class="max-w-[650px] text-[16px] leading-relaxed text-[var(--color-muted)] md:text-[17px]">{data.description}</p>
        </div>

        <div class="relative flex flex-col justify-between border-t border-white/8 bg-[var(--color-coral)]/[0.055] p-6 lg:border-l lg:border-t-0 lg:p-8">
          <div>
            <span class="mb-2 block font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-muted)]">Inversión total</span>
            <div class="flex items-end gap-2">
              <span class="pb-1.5 font-mono text-[10px] uppercase tracking-wider text-[var(--color-amber)]">USD</span>
              <strong class="text-[52px] font-semibold leading-none tracking-[-0.05em] text-white">{data.price}</strong>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-[var(--color-muted)]">Desarrollo y hospedaje durante los primeros 12 meses.</p>
          </div>

          <div class="mt-6 border-t border-white/10 pt-5">
            <div class="mb-5 flex items-center justify-between gap-4 text-sm">
              <span class="text-[var(--color-muted)]">Forma de pago</span>
              <strong class="text-right font-medium text-white">2 pagos de {formatUsd(initialPayment)}</strong>
            </div>
            <a href={inquiryUrl} target="_blank" rel="noopener noreferrer" class="keycap-btn w-full justify-center">
              Consultar este plan
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </a>
          </div>
        </div>
      </div>

      <dl class="relative grid grid-cols-2 border-t border-white/8 bg-white/[0.018] sm:grid-cols-3 lg:grid-cols-5">
        <div class="spec-cell col-span-2 sm:col-span-1">
          <dt>Alcance</dt>
          <dd>{data.scope}</dd>
        </div>
        <div class="spec-cell">
          <dt>Entrega</dt>
          <dd>{data.duration}</dd>
        </div>
        <div class="spec-cell">
          <dt>Revisiones</dt>
          <dd>{data.revisions}</dd>
        </div>
        <div class="spec-cell">
          <dt>Soporte</dt>
          <dd>{data.support}</dd>
        </div>
        <div class="spec-cell col-span-2 sm:col-span-1">
          <dt>Validez</dt>
          <dd>{data.validity}</dd>
        </div>
      </dl>
    </header>

    <nav class="command-bar-mockup mb-10 flex gap-1 overflow-x-auto p-1.5" aria-label="Contenido principal del plan">
      <a href="#resumen" class="plan-nav-link">Resumen</a>
      <a href="#alcance" class="plan-nav-link">Qué incluye</a>
      <a href="#inversion" class="plan-nav-link">Inversión y pagos</a>
      <a href="#cronograma" class="plan-nav-link">Cronograma</a>
      <a href="#condiciones" class="plan-nav-link">Condiciones</a>
    </nav>

    <section id="resumen" class="plan-section scroll-mt-28" aria-labelledby="resumen-plan-heading">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(280px,0.7fr)] lg:items-start">
        <div>
          <span class="section-eyebrow">Resumen del plan</span>
          <h2 id="resumen-plan-heading" class="section-heading">Un alcance claro antes de comenzar.</h2>
          <div class="body-copy space-y-3.5">
            {data.introduction.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <aside class="rounded-xl border border-white/10 bg-white/[0.025] p-5 md:p-6" aria-label="Aspectos principales incluidos">
          <span class="mb-4 block font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-amber)]">Incluye desde el inicio</span>
          <ul class="space-y-3">
            {data.highlights.map((highlight) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-[var(--color-muted)]">
                <svg class="mt-0.5 shrink-0 text-[var(--color-amber)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section id="alcance" class="plan-section scroll-mt-28" aria-labelledby="alcance-heading">
      <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="section-eyebrow">Alcance contratado</span>
          <h2 id="alcance-heading" class="section-heading !mb-0">Todo lo que contempla</h2>
        </div>
        <span class="font-mono text-[9px] uppercase tracking-[0.13em] text-[var(--color-muted)]">{data.includes.length} elementos incluidos</span>
      </div>

      <details class="scope-details">
        <summary>
          <span>Consultar alcance completo</span>
          <span class="details-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
          </span>
        </summary>
        <ul class="includes-grid">
          {data.includes.map((item) => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section id="inversion" class="plan-section scroll-mt-28" aria-labelledby="inversion-heading">
      <span class="section-eyebrow">Condiciones económicas</span>
      <h2 id="inversion-heading" class="section-heading">Inversión, pagos y renovaciones</h2>

      <div class="grid gap-5 lg:grid-cols-2">
        <article class="commercial-card">
          <div class="mb-6 flex items-end justify-between gap-4 border-b border-white/8 pb-5">
            <div>
              <span class="mb-2 block font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Desarrollo + hospedaje</span>
              <strong class="text-3xl font-semibold tracking-[-0.035em] text-white">{formatUsd(data.price)}</strong>
            </div>
            <span class="text-right font-mono text-[8px] uppercase tracking-[0.12em] text-[var(--color-amber)]">12 meses incluidos</span>
          </div>

          <p class="body-copy mb-6">{data.investmentDescription}</p>

          <dl class="divide-y divide-white/8 border-y border-white/8">
            <div class="commercial-row"><dt>50 % para iniciar</dt><dd>{formatUsd(initialPayment)}</dd></div>
            <div class="commercial-row"><dt>{data.paymentFinalLabel}</dt><dd>{formatUsd(initialPayment)}</dd></div>
            <div class="commercial-row"><dt>Dominio</dt><dd>Se cancela por separado</dd></div>
            {data.externalServices && <div class="commercial-row"><dt>Servicios externos</dt><dd>Se cancelan por separado</dd></div>}
          </dl>
        </article>

        <article class="commercial-card">
          <div class="mb-5">
            <span class="mb-2 block font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Dominio y servicios anuales</span>
            <h3 class="text-xl font-semibold text-white">Costos después de publicar</h3>
          </div>

          <p class="body-copy">El dominio no está incluido. Su precio dependerá del nombre y de la extensión seleccionada.</p>
          <div class="my-4 flex flex-wrap gap-2" aria-label="Ejemplos de extensiones de dominio">
            {['.com', '.com.ec', '.ec', 'Otra extensión'].map((extension) => <span class="domain-chip">{extension}</span>)}
          </div>
          <p class="body-copy mb-5">Micrudev enviará las opciones disponibles para que el cliente elija antes de realizar el registro y configuración.</p>
          <p class="detail-note !mb-5 !mt-0">El dominio deberá ser cancelado por el cliente antes de realizar su registro y configuración.</p>

          <dl class="divide-y divide-white/8 border-y border-white/8">
            <div class="commercial-row"><dt>Hospedaje · primer año</dt><dd>Incluido</dd></div>
            <div class="commercial-row"><dt>Desde el segundo año</dt><dd>{data.hostingRenewal}</dd></div>
            <div class="commercial-row"><dt>Dominio</dt><dd>Renovación independiente</dd></div>
          </dl>

          {data.hostingNotes.length > 0 && (
            <div class="mt-5 space-y-3 text-[13px] leading-relaxed text-[var(--color-muted)]">
              {data.hostingNotes.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          )}
          <p class="mt-5 text-[13px] leading-relaxed text-[var(--color-muted)]">Micrudev notificará antes de las fechas de vencimiento para coordinar las renovaciones.</p>
        </article>
      </div>
    </section>

    <section id="cronograma" class="plan-section scroll-mt-28" aria-labelledby="cronograma-heading">
      <div class="grid gap-8 lg:grid-cols-[280px_minmax(0,1fr)]">
        <div>
          <span class="section-eyebrow">Cronograma</span>
          <h2 id="cronograma-heading" class="section-heading">{data.duration}</h2>
          <p class="body-copy">El tiempo comienza a contar cuando se recibe el pago inicial y todo el material necesario.</p>
          <p class="detail-note">{data.timelineWaitingNote}</p>
        </div>

        <div class="rounded-xl border border-white/10 bg-white/[0.025] p-5 md:p-6">
          <h3 class="mb-5 text-base font-semibold text-white">Información necesaria para comenzar</h3>
          <ul class="detail-list timeline-list">
            {data.timelineInputs.map((item) => <li><span></span>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="condiciones" class="plan-section scroll-mt-28" aria-labelledby="condiciones-heading">
      <div class="mb-7 max-w-[720px]">
        <span class="section-eyebrow">Términos del servicio</span>
        <h2 id="condiciones-heading" class="section-heading">Condiciones explicadas, sin letra pequeña.</h2>
        <p class="body-copy">Consulta el detalle sobre diseño, revisiones, soporte, contenido y requisitos específicos de este plan.</p>
      </div>

      <div class="space-y-3">
        {data.detailSections.map((section) => (
          <details id={section.id} class="term-details scroll-mt-28">
            <summary>
              <span>
                <span class="mb-1 block font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-coral)]">{section.eyebrow}</span>
                <strong>{section.title}</strong>
              </span>
              <span class="details-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
              </span>
            </summary>
            <div class="term-body">
              {section.paragraphs.length > 0 && (
                <div class="body-copy space-y-3.5">
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              )}
              {section.items.length > 0 && (
                <div class="mt-5">
                  {section.listTitle && <h3 class="mb-4 text-sm font-semibold text-white">{section.listTitle}</h3>}
                  <ul class="detail-list terms-list">
                    {section.items.map((item) => <li><span></span>{item}</li>)}
                  </ul>
                </div>
              )}
              {section.note && <p class="detail-note">{section.note}</p>}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="plan-cta mt-10" aria-labelledby="resumen-comercial-heading">
      <div>
        <span class="mb-2 block font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-amber)]">Cotización válida por {data.validity}</span>
        <h2 id="resumen-comercial-heading" class="text-2xl font-semibold tracking-tight text-white md:text-3xl">{data.name} · {formatUsd(data.price)}</h2>
        <p class="mt-3 max-w-[650px] text-sm leading-relaxed text-[var(--color-muted)]">50 % al inicio y 50 % antes de publicar · {data.duration} · hospedaje del primer año incluido.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <a href={inquiryUrl} target="_blank" rel="noopener noreferrer" class="keycap-btn justify-center">Quiero este plan</a>
        <a href="mailto:hola@micrudev.com" class="ghost-pill justify-center">Escribir por correo</a>
      </div>
    </section>

    <section class="mt-14 border-t border-white/8 pt-8" aria-labelledby="otros-planes-heading">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <span class="mb-2 block font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Otros niveles</span>
          <h2 id="otros-planes-heading" class="text-xl font-semibold text-white">Compara antes de decidir</h2>
        </div>
        <a href="/planes" class="text-xs font-medium text-[var(--color-muted)] transition-colors hover:text-white">Ver comparativa completa</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {otherPlans.map((entry) => (
          <a href={`/planes/${entry.id}`} class="group flex items-center justify-between gap-5 rounded-xl border border-white/10 bg-white/[0.025] p-5 transition-colors hover:border-[var(--color-coral)]/40 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-amber)]">
            <span>
              <span class="mb-1 block font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-coral)]">{entry.data.level}</span>
              <strong class="text-base font-semibold text-white">{entry.data.name}</strong>
            </span>
            <span class="flex shrink-0 items-center gap-2 text-sm text-[var(--color-muted)] transition-colors group-hover:text-white">
              {formatUsd(entry.data.price)}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</main>

<style>
  .spec-cell {
    min-width: 0;
    padding: 1rem 1.1rem;
    border-right: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .spec-cell dt {
    margin-bottom: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .spec-cell dd {
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .plan-nav-link {
    flex: 0 0 auto;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .plan-nav-link:hover,
  .plan-nav-link:focus-visible {
    background: color-mix(in srgb, var(--color-coral) 8%, transparent);
    color: var(--color-white);
    outline: none;
  }

  .plan-section {
    padding-block: 2.75rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .section-eyebrow {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .section-heading {
    margin-bottom: 1.25rem;
    color: var(--color-white);
    font-size: clamp(1.7rem, 4vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .body-copy {
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .scope-details,
  .term-details {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-white) 2.5%, transparent);
  }

  .scope-details summary,
  .term-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem;
    color: var(--color-white);
    cursor: pointer;
    list-style: none;
  }

  .scope-details summary {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .term-details summary strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .scope-details summary::-webkit-details-marker,
  .term-details summary::-webkit-details-marker {
    display: none;
  }

  .details-icon {
    display: flex;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 999px;
    color: var(--color-muted);
    transition: transform 180ms ease, color 180ms ease;
  }

  details[open] > summary .details-icon {
    color: var(--color-white);
    transform: rotate(45deg);
  }

  .includes-grid {
    display: grid;
    gap: 0.75rem 1.5rem;
    padding: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
    list-style: none;
  }

  .includes-grid li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .includes-grid svg {
    flex: 0 0 auto;
    margin-top: 0.25rem;
    color: var(--color-amber);
  }

  .commercial-card {
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--color-white) 2.5%, transparent);
  }

  .commercial-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .commercial-row dt {
    color: var(--color-muted);
  }

  .commercial-row dd {
    max-width: 52%;
    color: var(--color-white);
    font-weight: 500;
    text-align: right;
  }

  .domain-chip {
    padding: 0.35rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.35rem;
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .detail-note {
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-coral);
    border-radius: 0 0.5rem 0.5rem 0;
    background: color-mix(in srgb, var(--color-coral) 7%, transparent);
    color: var(--color-muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .detail-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail-list li {
    break-inside: avoid;
    display: flex;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .detail-list li > span {
    flex: 0 0 auto;
    width: 0.32rem;
    height: 0.32rem;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--color-coral);
  }

  .term-body {
    padding: 1.15rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .plan-cta {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-coral) 28%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-coral) 7%, transparent);
  }

