---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
import { getWhatsAppUrl } from '../lib/contact';
import { isNavigationItemCurrent, navigationItems } from '../lib/navigation';

const budgetUrl = getWhatsAppUrl('Hola Micrudev, quisiera conversar sobre un proyecto y solicitar un presupuesto.');
const pathname = Astro.url.pathname;
const budgetLabel = 'Cotizar proyecto';
const isHome = pathname === '/';

const navItems = navigationItems.map((item) => ({
  ...item,
  displayHref: isHome && item.homeHref ? item.homeHref : item.href,
  current: isNavigationItemCurrent(item, pathname),
  observedSectionId: isHome ? item.sectionId : undefined,
}));
---

<nav id="site-nav" class="site-nav fixed left-1/2 top-3 z-50 flex w-[calc(100%_-_1.5rem)] max-w-[1040px] -translate-x-1/2 items-center justify-between rounded-[16px] px-2 py-2 lg:top-5 lg:px-2.5" aria-label="Navegación principal">
  <a href="/" class="brand-link relative z-10 flex min-h-11 items-center rounded-[10px] px-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
    <img src={logoWhite.src} alt="" class="hidden h-5 dark:block" />
    <img src={logoPrimary.src} alt="" class="block h-5 dark:hidden" />
  </a>

  <div class="nav-rail hidden items-center gap-0.5 lg:flex">
    {navItems.map((item) => (
      <a
        href={item.displayHref}
        data-home-section={item.observedSectionId}
        aria-current={item.current ? 'page' : undefined}
        class:list={[
          'desktop-nav-link relative flex min-h-11 items-center rounded-[9px] px-4 text-[13px] font-medium text-[var(--color-muted)] transition-[color,background-color] hover:bg-white/[0.035] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-amber)]',
          { 'desktop-nav-link--active': item.current },
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>

  <div class="hidden items-center gap-1.5 lg:flex">
    <button class="theme-toggle flex h-11 w-11 items-center justify-center rounded-[10px] text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="nav-cta flex min-h-11 items-center gap-2 whitespace-nowrap rounded-[10px] bg-[var(--color-white)] px-4 text-[13px] font-semibold text-[var(--color-canvas)] transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
      {budgetLabel}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <div class="flex items-center gap-1 lg:hidden">
    <button class="theme-toggle flex h-11 w-11 items-center justify-center rounded-[10px] text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <button id="mobile-menu-btn" class="relative z-10 flex h-11 w-11 items-center justify-center rounded-[10px] text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block" aria-hidden="true"><line x1="5" x2="19" y1="8" y2="8"/><line x1="5" x2="19" y1="16" y2="16"/></svg>
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
</nav>

<div id="mobile-menu-backdrop" class="pointer-events-none fixed inset-0 z-30 bg-[var(--color-canvas)]/45 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 lg:hidden" aria-hidden="true"></div>

<nav id="mobile-menu" class="mobile-menu-surface pointer-events-none fixed left-1/2 top-[4.75rem] z-40 flex max-h-[calc(100dvh_-_5.5rem)] w-[calc(100%_-_1.5rem)] max-w-[640px] -translate-x-1/2 -translate-y-3 flex-col overflow-y-auto rounded-[18px] p-2 opacity-0 transition-[transform,opacity] duration-300 ease-out lg:hidden" aria-label="Navegación móvil" aria-hidden="true" inert>
  <div class="flex flex-col gap-0.5">
    {navItems.map((item) => (
      <a
        href={item.displayHref}
        data-home-section={item.observedSectionId}
        aria-current={item.current ? 'page' : undefined}
        class:list={[
          'mobile-link mobile-nav-link group relative flex min-h-14 items-center justify-between rounded-xl px-4 text-base font-[500] text-[var(--color-muted)] transition-colors hover:bg-white/[0.04] hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--color-amber)]',
          { 'mobile-nav-link--active': item.current },
        ]}
      >
        <span>{item.label}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    ))}
  </div>

  <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="mx-2 mb-2 mt-2 flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[var(--color-white)] px-4 text-center text-sm font-[600] text-[var(--color-canvas)] shadow-[0_0_20px_-5px_rgba(2,83,253,0.3)] transition-colors hover:bg-[var(--color-white)]/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
    {budgetLabel}
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
</nav>

<style>
  .site-nav,
  .mobile-menu-surface {
    border: 1px solid var(--theme-nav-border);
    background: color-mix(in srgb, var(--theme-nav-bg) 92%, transparent);
    box-shadow: var(--theme-nav-shadow);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
  }

  .site-nav {
    transition: border-color 220ms ease, box-shadow 220ms ease, background-color 220ms ease;
  }

  .site-nav[data-scrolled='true'] {
    border-color: color-mix(in srgb, var(--color-coral) 18%, var(--theme-nav-border));
    box-shadow: 0 18px 60px color-mix(in srgb, var(--color-black) 26%, transparent), var(--theme-nav-shadow);
  }

  .desktop-nav-link--active,
  .mobile-nav-link--active {
    color: var(--color-white);
  }

  .desktop-nav-link--active {
    background: color-mix(in srgb, var(--color-coral) 8%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-coral) 16%, transparent);
  }

  .mobile-nav-link--active {
    background: color-mix(in srgb, var(--color-coral) 7%, transparent);
  }

  .mobile-nav-link--active::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    width: 2px;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--color-amber);
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-amber) 65%, transparent);
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }
</style>

<script>
  const siteNav = document.querySelector<HTMLElement>('#site-nav');
  const updateNavSurface = () => siteNav?.setAttribute('data-scrolled', String(window.scrollY > 24));
  window.addEventListener('scroll', updateNavSurface, { passive: true });
  updateNavSurface();

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    });
  });

  const mobileMenuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const mobileMenuBackdrop = document.querySelector<HTMLElement>('#mobile-menu-backdrop');
  const menuIcon = document.querySelector<SVGElement>('#menu-icon');
  const closeIcon = document.querySelector<SVGElement>('#close-icon');

  function setMenuState(open: boolean, restoreFocus = false) {
    if (!mobileMenuButton || !mobileMenu || !menuIcon || !closeIcon) return;

    mobileMenuButton.setAttribute('aria-expanded', String(open));
    mobileMenuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    mobileMenu.classList.toggle('-translate-y-3', !open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('pointer-events-none', !open);
    mobileMenu.classList.toggle('translate-y-0', open);
    mobileMenu.classList.toggle('opacity-100', open);
    mobileMenu.classList.toggle('pointer-events-auto', open);
    mobileMenuBackdrop?.classList.toggle('opacity-0', !open);
    mobileMenuBackdrop?.classList.toggle('pointer-events-none', !open);
    mobileMenuBackdrop?.classList.toggle('opacity-100', open);
    mobileMenuBackdrop?.classList.toggle('pointer-events-auto', open);
    menuIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
    document.body.classList.toggle('mobile-menu-open', open);

    if (!open && restoreFocus) mobileMenuButton.focus();
  }

  mobileMenuButton?.addEventListener('click', () => {
    setMenuState(mobileMenuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll<HTMLAnchorElement>('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  mobileMenuBackdrop?.addEventListener('click', () => setMenuState(false, true));

  document.addEventListener('click', (event) => {
    if (!mobileMenuButton || !mobileMenu || mobileMenuButton.getAttribute('aria-expanded') !== 'true') return;
    if (!(event.target instanceof Node)) return;
    if (!mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) setMenuState(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') setMenuState(false, true);
  });

  const desktopMedia = window.matchMedia('(min-width: 1024px)');
  desktopMedia.addEventListener('change', ({ matches }) => {
    if (matches) setMenuState(false);
  });

  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-home-section]'));
  const sectionTargets = sectionLinks
    .map((link) => document.getElementById(link.dataset.homeSection ?? ''))
    .filter((section): section is HTMLElement => Boolean(section));
  const observedSections = Array.from(new Map(sectionTargets.map((section) => [section.id, section])).values());

  if (observedSections.length > 0) {
    const updateCurrentSection = () => {
      const marker = window.scrollY + Math.min(window.innerHeight * 0.34, 280);
      let currentSectionId = '';

      observedSections
        .map((section) => ({
          id: section.id,
          top: section.getBoundingClientRect().top + window.scrollY,
        }))
        .sort((a, b) => a.top - b.top)
        .forEach((section) => {
          if (section.top <= marker) currentSectionId = section.id;
        });

      sectionLinks.forEach((link) => {
        const isCurrent = link.dataset.homeSection === currentSectionId;
        link.classList.toggle('desktop-nav-link--active', isCurrent);
        link.classList.toggle('mobile-nav-link--active', isCurrent);
        if (isCurrent) link.setAttribute('aria-current', 'location');
        else if (link.getAttribute('aria-current') === 'location') link.removeAttribute('aria-current');
      });
    };

    let sectionFrame = 0;
    const scheduleCurrentSectionUpdate = () => {
      if (sectionFrame) return;

      sectionFrame = requestAnimationFrame(() => {
        sectionFrame = 0;
        updateCurrentSection();
      });
    };

    window.addEventListener('scroll', scheduleCurrentSectionUpdate, { passive: true });
    window.addEventListener('resize', scheduleCurrentSectionUpdate);
    updateCurrentSection();
  }
</script>
