---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
import { getWhatsAppUrl } from '../lib/contact';
import { isNavigationItemCurrent, navigationItems } from '../lib/navigation';

const budgetUrl = getWhatsAppUrl('Hola Micrudev, quisiera conversar sobre un proyecto y solicitar un presupuesto.');
const pathname = Astro.url.pathname;
const budgetLabel = 'Cotizar proyecto';

const navItems = navigationItems.map((item) => ({
  ...item,
  current: isNavigationItemCurrent(item, pathname),
}));
---

<nav class="nav-pill fixed left-1/2 top-4 z-50 flex w-[90%] max-w-[640px] -translate-x-1/2 items-center justify-between rounded-full px-3 py-1.5 lg:top-8 lg:max-w-[840px] lg:px-4" aria-label="Navegación principal">
  <a href="/" class="relative z-10 flex min-h-11 items-center gap-2 rounded px-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
    <img src={logoWhite.src} alt="" class="hidden h-5 dark:block" />
    <img src={logoPrimary.src} alt="" class="block h-5 dark:hidden" />
  </a>

  <div class="hidden items-center gap-5 lg:flex xl:gap-6">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={item.current ? 'page' : undefined}
        class:list={[
          'desktop-nav-link relative rounded px-0.5 py-3 text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-[var(--color-amber)]',
          { 'desktop-nav-link--active': item.current },
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>

  <div class="hidden items-center gap-3 lg:flex">
    <button class="theme-toggle flex h-11 w-11 items-center justify-center rounded-full text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center gap-2 whitespace-nowrap rounded-full border border-white/10 bg-[var(--color-white)] px-4 text-sm font-medium text-[var(--color-canvas)] shadow-sm transition-colors hover:bg-[var(--color-white)]/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      {budgetLabel}
    </a>
  </div>

  <button id="mobile-menu-btn" class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)] lg:hidden" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
    <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</nav>

<div id="mobile-menu-backdrop" class="pointer-events-none fixed inset-0 z-30 bg-[var(--color-canvas)]/45 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 lg:hidden" aria-hidden="true"></div>

<nav id="mobile-menu" class="nav-pill pointer-events-none fixed left-1/2 top-20 z-40 flex max-h-[calc(100dvh-6rem)] w-[90%] max-w-[640px] -translate-x-1/2 -translate-y-3 flex-col gap-6 overflow-y-auto rounded-[1.5rem] px-6 pb-6 pt-5 opacity-0 transition-[transform,opacity] duration-300 ease-out lg:hidden" aria-label="Navegación móvil" aria-hidden="true" inert>
  <div class="flex flex-col gap-2 text-center">
    {navItems.map((item) => (
      <a
        href={item.href}
        aria-current={item.current ? 'page' : undefined}
        class:list={[
          'mobile-link mobile-nav-link relative inline-flex min-h-11 items-center self-center rounded-lg px-4 text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]',
          { 'mobile-nav-link--active': item.current },
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>

  <div class="h-px w-full bg-[var(--color-white)]/10"></div>

  <div class="flex items-center justify-between px-4">
    <span class="text-sm font-medium text-[var(--color-muted)]">Modo de visualización</span>
    <button class="theme-toggle flex h-11 w-11 items-center justify-center rounded-full border border-[var(--theme-nav-border)] bg-[var(--color-canvas)] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </div>

  <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-white)] px-4 text-center text-sm font-[600] text-[var(--color-canvas)] shadow-[0_0_20px_-5px_rgba(2,83,253,0.3)] transition-colors hover:bg-[var(--color-white)]/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    {budgetLabel}
  </a>
</nav>

<style>
  .desktop-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.3rem;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: var(--color-amber);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-amber) 70%, transparent);
    opacity: 0;
    transform: translateX(-50%) scale(0.5);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .desktop-nav-link--active,
  .mobile-nav-link--active {
    color: var(--color-white);
  }

  .desktop-nav-link--active::after {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .mobile-nav-link--active::before {
    content: '';
    position: absolute;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: var(--color-amber);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-amber) 70%, transparent);
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    });
  });

  const mobileMenuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const mobileMenuBackdrop = document.querySelector<HTMLElement>('#mobile-menu-backdrop');
  const menuIcon = document.querySelector<SVGElement>('#menu-icon');
  const closeIcon = document.querySelector<SVGElement>('#close-icon');

  function setMenuState(open: boolean, restoreFocus = false) {
    if (!mobileMenuButton || !mobileMenu || !menuIcon || !closeIcon) return;

    mobileMenuButton.setAttribute('aria-expanded', String(open));
    mobileMenuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    mobileMenu.classList.toggle('-translate-y-3', !open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('pointer-events-none', !open);
    mobileMenu.classList.toggle('translate-y-0', open);
    mobileMenu.classList.toggle('opacity-100', open);
    mobileMenu.classList.toggle('pointer-events-auto', open);
    mobileMenuBackdrop?.classList.toggle('opacity-0', !open);
    mobileMenuBackdrop?.classList.toggle('pointer-events-none', !open);
    mobileMenuBackdrop?.classList.toggle('opacity-100', open);
    mobileMenuBackdrop?.classList.toggle('pointer-events-auto', open);
    menuIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);
    document.body.classList.toggle('mobile-menu-open', open);

    if (!open && restoreFocus) mobileMenuButton.focus();
  }

  mobileMenuButton?.addEventListener('click', () => {
    setMenuState(mobileMenuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll<HTMLAnchorElement>('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  mobileMenuBackdrop?.addEventListener('click', () => setMenuState(false, true));

  document.addEventListener('click', (event) => {
    if (!mobileMenuButton || !mobileMenu || mobileMenuButton.getAttribute('aria-expanded') !== 'true') return;
    if (!(event.target instanceof Node)) return;
    if (!mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) setMenuState(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') setMenuState(false, true);
  });

  const desktopMedia = window.matchMedia('(min-width: 1024px)');
  desktopMedia.addEventListener('change', ({ matches }) => {
    if (matches) setMenuState(false);
  });
</script>
