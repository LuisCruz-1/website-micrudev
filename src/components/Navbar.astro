---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
---

<!-- Desktop & Mobile Pill -->
<nav class="fixed top-8 left-1/2 -translate-x-1/2 z-50 nav-pill rounded-full px-4 py-2.5 flex items-center justify-between w-[90%] max-w-[800px]">
  <!-- Left: Logo -->
  <a href="/" class="flex items-center gap-2 relative z-10">
    <img src={logoWhite.src} alt="Micrudev Logo" class="h-5 hidden dark:block" />
    <img src={logoPrimary.src} alt="Micrudev Logo" class="h-5 block dark:hidden" />
  </a>

  <!-- Center: Desktop Links -->
  <div class="hidden md:flex items-center gap-6">
    <a href="/#servicios" class="text-sm font-medium text-[var(--color-muted)] hover:text-white transition-colors">Servicios</a>
    <a href="/proyectos" class="text-sm font-medium text-[var(--color-muted)] hover:text-white transition-colors">Proyectos</a>
    <a href="/#stack" class="text-sm font-medium text-[var(--color-muted)] hover:text-white transition-colors">Stack</a>
    <a href="/#precios" class="text-sm font-medium text-[var(--color-muted)] hover:text-white transition-colors">Precios</a>
    <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-[var(--color-muted)] hover:text-white transition-colors">Contacto</a>
  </div>

  <!-- Right: Desktop Actions & Theme Toggle -->
  <div class="hidden md:flex items-center gap-2 md:gap-4">
    <button class="theme-toggle p-2 rounded-full text-[var(--color-muted)] hover:text-[var(--color-white)] hover:bg-white/5 transition-colors focus:outline-none" aria-label="Cambiar tema">
      <!-- Sun Icon (shown in dark mode) -->
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="text-sm font-medium bg-[var(--color-white)] hover:bg-[var(--color-white)]/90 text-[var(--color-canvas)] px-4 py-1.5 rounded-full border border-white/10 transition-colors flex items-center gap-2 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      Presupuesto
    </a>
  </div>

  <!-- Mobile Menu Button -->
  <button id="mobile-menu-btn" class="md:hidden p-2 rounded-full text-[var(--color-muted)] hover:text-[var(--color-white)] hover:bg-white/5 transition-colors focus:outline-none relative z-10" aria-label="Abrir menú">
    <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-x-0 top-0 pt-28 pb-8 px-6 bg-[var(--theme-nav-bg)] backdrop-blur-2xl border-b border-[var(--theme-nav-border)] shadow-2xl z-40 flex flex-col gap-6 transform -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-in-out md:hidden">
  
  <div class="flex flex-col gap-5 text-center mt-4">
    <a href="/#servicios" class="mobile-link text-lg font-[500] text-[var(--color-muted)] hover:text-[var(--color-white)] transition-colors">Servicios</a>
    <a href="/proyectos" class="mobile-link text-lg font-[500] text-[var(--color-muted)] hover:text-[var(--color-white)] transition-colors">Proyectos</a>
    <a href="/#stack" class="mobile-link text-lg font-[500] text-[var(--color-muted)] hover:text-[var(--color-white)] transition-colors">Stack</a>
    <a href="/#precios" class="mobile-link text-lg font-[500] text-[var(--color-muted)] hover:text-[var(--color-white)] transition-colors">Precios</a>
    <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="mobile-link text-lg font-[500] text-[var(--color-muted)] hover:text-[var(--color-white)] transition-colors">Contacto</a>
  </div>
  
  <div class="h-px w-full bg-[var(--color-white)]/10 my-2"></div>
  
  <div class="flex items-center justify-between px-4">
    <span class="text-sm font-medium text-[var(--color-muted)]">Modo de visualización</span>
    <button class="theme-toggle p-2 rounded-full text-[var(--color-muted)] hover:text-[var(--color-white)] bg-[var(--color-canvas)] border border-[var(--theme-nav-border)] transition-colors focus:outline-none" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </div>

  <a href="https://wa.me/593998081684" target="_blank" rel="noopener noreferrer" class="mt-4 w-full text-center text-sm font-[600] bg-[var(--color-white)] text-[var(--color-canvas)] px-4 py-3.5 rounded-xl transition-all flex items-center justify-center gap-2 shadow-[0_0_20px_-5px_rgba(2,83,253,0.3)] hover:scale-[1.02]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    Solicitar Presupuesto
  </a>
</div>

<script>
  // Theme toggle logic
  const themeToggles = document.querySelectorAll('.theme-toggle');

  themeToggles.forEach(btn => {
    btn.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      
      if (document.documentElement.classList.contains('dark')) {
        localStorage.setItem('theme', 'dark');
      } else {
        localStorage.setItem('theme', 'light');
      }
    });
  });

  // Mobile menu logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    const isMenuOpen = !mobileMenu.classList.contains('opacity-0');
    
    if (isMenuOpen) {
      // Close menu
      mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-full');
      mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      menuIcon.classList.remove('hidden');
      menuIcon.classList.add('block');
      closeIcon.classList.add('hidden');
      closeIcon.classList.remove('block');
    } else {
      // Open menu
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-full');
      mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      menuIcon.classList.add('hidden');
      menuIcon.classList.remove('block');
      closeIcon.classList.remove('hidden');
      closeIcon.classList.add('block');
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', toggleMenu);
  }

  // Close menu when a link is clicked
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!mobileMenu.classList.contains('opacity-0')) {
        toggleMenu();
      }
    });
  });

  // Close menu when clicking/tapping outside of it
  document.addEventListener('click', (e) => {
    if (!mobileMenu || mobileMenu.classList.contains('opacity-0')) return;
    if (mobileMenu.classList.contains('md:hidden') === false) return;

    const target = e.target;
    const clickedInsideMenu = mobileMenu.contains(target);
    const clickedOnButton = mobileMenuBtn.contains(target);

    if (!clickedInsideMenu && !clickedOnButton) {
      toggleMenu();
    }
  });

  // Close menu with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('opacity-0')) {
      toggleMenu();
    }
  });
</script>