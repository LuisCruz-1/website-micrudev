---
import logoWhite from '../../public/logos/Micrudev_Logo_Monochrome_White.svg';
import logoPrimary from '../../public/logos/Micrudev_Logo_Primary.svg';
import { getWhatsAppUrl } from '../lib/contact';

const budgetUrl = getWhatsAppUrl('Hola Micrudev, quisiera conversar sobre un proyecto y solicitar un presupuesto.');
---

<nav class="nav-pill fixed left-1/2 top-8 z-50 flex w-[90%] max-w-[800px] -translate-x-1/2 items-center justify-between rounded-full px-4 py-2.5" aria-label="Navegación principal">
  <a href="/" class="relative z-10 flex items-center gap-2 rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]" aria-label="Micrudev, inicio">
    <img src={logoWhite.src} alt="" class="hidden h-5 dark:block" />
    <img src={logoPrimary.src} alt="" class="block h-5 dark:hidden" />
  </a>

  <div class="hidden items-center gap-6 md:flex">
    <a href="/#servicios" class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">Servicios</a>
    <a href="/proyectos" class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">Proyectos</a>
    <a href="/planes" class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">Planes</a>
    <a href="/#stack" class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">Stack</a>
    <a href="/#contacto" class="text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">Contacto</a>
  </div>

  <div class="hidden items-center gap-2 md:flex md:gap-4">
    <button class="theme-toggle rounded-full p-2 text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-full border border-white/10 bg-[var(--color-white)] px-4 py-1.5 text-sm font-medium text-[var(--color-canvas)] shadow-sm transition-colors hover:bg-[var(--color-white)]/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      Presupuesto
    </a>
  </div>

  <button id="mobile-menu-btn" class="relative z-10 rounded-full p-2 text-[var(--color-muted)] transition-colors hover:bg-white/5 hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)] md:hidden" aria-label="Abrir menú" aria-controls="mobile-menu" aria-expanded="false">
    <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</nav>

<div id="mobile-menu" class="fixed inset-x-0 top-0 z-40 flex max-h-[100dvh] -translate-y-full flex-col gap-6 overflow-y-auto border-b border-[var(--theme-nav-border)] bg-[var(--theme-nav-bg)] px-6 pb-8 pt-28 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 ease-in-out md:hidden" aria-hidden="true" inert>
  <div class="mt-4 flex flex-col gap-5 text-center">
    <a href="/#servicios" class="mobile-link text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)]">Servicios</a>
    <a href="/proyectos" class="mobile-link text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)]">Proyectos</a>
    <a href="/planes" class="mobile-link text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)]">Planes</a>
    <a href="/#stack" class="mobile-link text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)]">Stack</a>
    <a href="/#contacto" class="mobile-link text-lg font-[500] text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)]">Contacto</a>
  </div>

  <div class="my-2 h-px w-full bg-[var(--color-white)]/10"></div>

  <div class="flex items-center justify-between px-4">
    <span class="text-sm font-medium text-[var(--color-muted)]">Modo de visualización</span>
    <button class="theme-toggle rounded-full border border-[var(--theme-nav-border)] bg-[var(--color-canvas)] p-2 text-[var(--color-muted)] transition-colors hover:text-[var(--color-white)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cambiar tema">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
  </div>

  <a href={budgetUrl} target="_blank" rel="noopener noreferrer" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-white)] px-4 py-3.5 text-center text-sm font-[600] text-[var(--color-canvas)] shadow-[0_0_20px_-5px_rgba(2,83,253,0.3)] transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    Solicitar presupuesto
  </a>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    });
  });

  const mobileMenuButton = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
  const menuIcon = document.querySelector<SVGElement>('#menu-icon');
  const closeIcon = document.querySelector<SVGElement>('#close-icon');

  function setMenuState(open: boolean, restoreFocus = false) {
    if (!mobileMenuButton || !mobileMenu || !menuIcon || !closeIcon) return;

    mobileMenuButton.setAttribute('aria-expanded', String(open));
    mobileMenuButton.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    mobileMenu.inert = !open;
    mobileMenu.classList.toggle('-translate-y-full', !open);
    mobileMenu.classList.toggle('opacity-0', !open);
    mobileMenu.classList.toggle('translate-y-0', open);
    mobileMenu.classList.toggle('opacity-100', open);
    menuIcon.classList.toggle('hidden', open);
    closeIcon.classList.toggle('hidden', !open);

    if (!open && restoreFocus) mobileMenuButton.focus();
  }

  mobileMenuButton?.addEventListener('click', () => {
    setMenuState(mobileMenuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll<HTMLAnchorElement>('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  document.addEventListener('click', (event) => {
    if (!mobileMenuButton || !mobileMenu || mobileMenuButton.getAttribute('aria-expanded') !== 'true') return;
    if (!(event.target instanceof Node)) return;
    if (!mobileMenu.contains(event.target) && !mobileMenuButton.contains(event.target)) setMenuState(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenuButton?.getAttribute('aria-expanded') === 'true') setMenuState(false, true);
  });
</script>
