---
import { render } from 'astro:content';
import type { Project } from '../lib/projects';
import { getProjectImageSrc, getProjects } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sectionHeadings = headings.filter(({ depth }) => depth === 2);
const projects = await getProjects();
const currentIndex = projects.findIndex(({ id }) => id === project.id);
const relatedProjects = [
  ...projects.slice(currentIndex + 1),
  ...projects.slice(0, currentIndex),
].slice(0, 2);
---

<main class="relative z-10 min-h-screen pb-16 pt-32 md:pt-36">
  <div class="container mx-auto max-w-[1100px] px-6">
    <a href="/proyectos" class="mb-5 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      Volver a proyectos
    </a>

    <section class="command-bar-mockup mb-10 overflow-hidden" aria-labelledby="project-title">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_400px]">
        <header class="flex flex-col p-6 sm:p-8 lg:p-10">
          <div class="mb-4 flex flex-wrap items-center gap-3">
            <span class="rounded-full border border-[var(--color-coral)]/30 bg-[var(--color-coral)]/10 px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-amber)]">{data.type}</span>
            <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Caso de proyecto</span>
          </div>
          <h1 id="project-title" class="mb-4 text-[38px] font-semibold leading-[1.04] tracking-[-0.04em] text-white sm:text-[44px] lg:text-[50px]">{data.title}</h1>
          <p class="max-w-[580px] text-[17px] leading-relaxed text-white/85">{data.subtitle}</p>
          <p class="mt-5 max-w-[590px] text-[14px] leading-7 text-[var(--color-muted)]">{data.excerpt}</p>

          {data.externalUrl && (
            <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="keycap-btn mt-7 self-start !px-5">
              Visitar proyecto
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
            </a>
          )}
        </header>

        <figure class="relative h-[230px] overflow-hidden border-t border-white/8 sm:h-[280px] lg:h-auto lg:min-h-[360px] lg:border-l lg:border-t-0">
          <img src={getProjectImageSrc(data.image)} alt={data.imageAlt} class="project-hero-image absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-canvas)]/60 via-transparent to-transparent"></div>
          <figcaption class="absolute bottom-4 left-4 rounded-md border border-white/10 bg-[var(--color-canvas)]/75 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.14em] text-white/75 backdrop-blur-md">
            {data.client} / {data.year}
          </figcaption>
        </figure>
      </div>

      <div class="grid border-t border-white/8 bg-white/[0.018] sm:grid-cols-[minmax(160px,0.7fr)_100px_minmax(0,2fr)]">
        <div class="border-b border-white/8 px-6 py-4 sm:border-b-0 sm:border-r">
          <span class="mb-1 block font-mono text-[8px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Cliente</span>
          <strong class="text-sm font-medium text-white">{data.client}</strong>
        </div>
        <div class="border-b border-white/8 px-6 py-4 sm:border-b-0 sm:border-r">
          <span class="mb-1 block font-mono text-[8px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Año</span>
          <strong class="text-sm font-medium text-white">{data.year}</strong>
        </div>
        <div class="px-6 py-4">
          <span class="mb-2 block font-mono text-[8px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Tecnologías</span>
          <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${data.title}`}>
            {data.tech.map((technology) => (
              <li class="rounded border border-white/10 bg-white/[0.025] px-2 py-1 font-mono text-[8px] uppercase tracking-[0.1em] text-white/80">{technology}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <div class:list={[
      'grid gap-8',
      sectionHeadings.length > 0
        ? 'lg:grid-cols-[180px_minmax(0,720px)] lg:justify-center lg:gap-12'
        : 'mx-auto max-w-[720px]',
    ]}>
      {sectionHeadings.length > 0 && (
        <aside class="hidden lg:block">
          <nav aria-label="Contenido del proyecto" class="project-toc-nav sticky top-32 max-h-[calc(100vh-9rem)] overflow-y-auto overscroll-contain border-l border-white/10 pl-4">
            <span class="mb-4 block font-mono text-[8px] uppercase tracking-[0.15em] text-[var(--color-muted)]">En este proyecto</span>
            <ol class="space-y-3">
              {sectionHeadings.map((heading, index) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-project-toc-link={heading.slug}
                    aria-current={index === 0 ? 'location' : undefined}
                    class:list={[
                      'project-toc-link group flex gap-3 text-[11px] leading-snug text-[var(--color-muted)] transition-colors hover:text-white',
                      { 'project-toc-link--active': index === 0 },
                    ]}
                  >
                    <span class="project-toc-number font-mono text-[8px] text-[var(--color-coral)]">{String(index + 1).padStart(2, '0')}</span>
                    <span>{heading.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}

      <article class="project-prose min-w-0">
        <Content />
      </article>
    </div>

    <section class="mt-14 border-t border-white/8 pt-8 md:mt-16" aria-labelledby="siguientes-proyectos-heading">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="mb-2 block font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-amber)]">Continúa explorando</span>
          <h2 id="siguientes-proyectos-heading" class="text-2xl font-semibold tracking-tight text-white">Otros proyectos</h2>
        </div>
        <a href="/proyectos" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">
          Ver colección completa
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {relatedProjects.map((entry) => (
          <a href={`/proyectos/${entry.id}`} class="group grid min-h-[104px] grid-cols-[92px_minmax(0,1fr)_36px] items-center overflow-hidden rounded-xl border border-white/10 bg-white/[0.025] transition-colors hover:border-[var(--color-coral)]/40 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-amber)]">
            <img src={getProjectImageSrc(entry.data.image)} alt="" class="h-full w-full object-cover opacity-75 transition-opacity group-hover:opacity-100" loading="lazy" />
            <div class="min-w-0 px-4 py-3">
              <span class="mb-1.5 block font-mono text-[8px] uppercase tracking-[0.13em] text-[var(--color-coral)]">{entry.data.type} · {entry.data.year}</span>
              <h3 class="truncate text-base font-semibold text-white">{entry.data.title}</h3>
              <p class="mt-1 line-clamp-1 text-xs text-[var(--color-muted)]">{entry.data.subtitle}</p>
            </div>
            <span class="flex h-7 w-7 items-center justify-center rounded-full border border-white/10 text-[var(--color-muted)] transition-colors group-hover:border-[var(--color-coral)]/40 group-hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</main>

<style>
  .project-hero-image {
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  section:hover .project-hero-image {
    transform: scale(1.025);
  }

  .project-prose :global(h2) {
    margin: 2.75rem 0 1rem;
    color: var(--color-white);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    scroll-margin-top: 7rem;
  }

  .project-prose :global(h3) {
    margin: 1.75rem 0 0.75rem;
    color: var(--color-white);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .project-prose :global(p) {
    margin: 0 0 1.1rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .project-prose :global(ul),
  .project-prose :global(ol) {
    margin: 1.5rem 0 2rem;
    padding-left: 1.35rem;
    color: var(--color-muted);
  }

  .project-prose :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .project-prose :global(li) {
    position: relative;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-prose :global(ul > li::before) {
    content: '';
    position: absolute;
    top: 0.72rem;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-coral);
  }

  .project-prose :global(ol) {
    counter-reset: project-steps;
    list-style: none;
    padding-left: 0;
  }

  .project-prose :global(ol > li) {
    counter-increment: project-steps;
    padding: 1rem 1rem 1rem 3.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .project-prose :global(ol > li::before) {
    content: counter(project-steps, decimal-leading-zero);
    position: absolute;
    top: 1.15rem;
    left: 1rem;
    color: var(--color-coral);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .project-prose :global(strong) {
    color: var(--color-white);
    font-weight: 600;
  }

  .project-prose :global(a) {
    color: var(--color-amber);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-amber) 40%, transparent);
    text-underline-offset: 0.2em;
  }

  .project-prose :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    border-left: 2px solid var(--color-coral);
    border-radius: 0 0.75rem 0.75rem 0;
    background: color-mix(in srgb, var(--color-coral) 7%, transparent);
  }

  .project-prose :global(blockquote p) {
    margin: 0;
    color: var(--color-white);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .project-prose :global(img) {
    width: 100%;
    margin: 2.5rem 0;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.875rem;
  }

  .project-prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
  }

  .project-prose :global(pre) {
    overflow-x: auto;
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-black) 60%, transparent);
  }

  .project-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .project-prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
    border-collapse: collapse;
  }

  .project-prose :global(th),
  .project-prose :global(td) {
    min-width: 10rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
    color: var(--color-muted);
    font-size: 0.9rem;
    text-align: left;
  }

  .project-prose :global(th) {
    color: var(--color-white);
    font-weight: 600;
  }

  .project-toc-link.project-toc-link--active {
    color: var(--color-white);
    font-weight: 600;
  }

  .project-toc-link.project-toc-link--active .project-toc-number {
    color: var(--color-amber);
  }

  .project-toc-nav {
    scroll-padding-block: 0.75rem;
    scrollbar-color: color-mix(in srgb, var(--color-white) 20%, transparent) transparent;
    scrollbar-width: thin;
  }

  .project-toc-nav::-webkit-scrollbar {
    width: 4px;
  }

  .project-toc-nav::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-white) 20%, transparent);
  }

  .project-prose :global(.project-flow) {
    counter-reset: project-flow-step;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2rem 0 2.5rem;
    padding: 0.5rem 0;
  }

  .project-prose :global(.project-flow-node) {
    counter-increment: project-flow-step;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: min(100%, 26rem);
    min-height: 3.25rem;
    margin: 0;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-coral) 24%, transparent);
    border-radius: 0.7rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-canvas) 92%, var(--color-coral)), color-mix(in srgb, var(--color-white) 4%, transparent));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-white) 3%, transparent), 0 10px 24px color-mix(in srgb, var(--color-black) 18%, transparent);
    color: var(--color-white);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .project-prose :global(.project-flow-node)::before {
    content: counter(project-flow-step, decimal-leading-zero);
    display: grid;
    flex: 0 0 auto;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-amber) 36%, transparent);
    border-radius: 999px;
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  .project-prose :global(.project-flow-node) :global(code) {
    min-width: 0;
    color: inherit;
    font-size: 0.95em;
    overflow-wrap: anywhere;
  }

  .project-prose :global(.project-flow-arrow) {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2.25rem;
    margin: 0;
    place-items: center;
    color: var(--color-amber);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    line-height: 1;
    text-shadow: 0 0 1rem color-mix(in srgb, var(--color-amber) 45%, transparent);
  }

  .project-prose :global(.project-flow-arrow)::before {
    content: '';
    position: absolute;
    top: -0.35rem;
    bottom: -0.35rem;
    left: 50%;
    z-index: -1;
    width: 1px;
    background: color-mix(in srgb, var(--color-amber) 30%, transparent);
  }

  @media (max-width: 639px) {
    .project-prose :global(p) {
      font-size: 1rem;
      line-height: 1.8;
    }

    .project-prose :global(blockquote) {
      padding: 1.25rem;
    }

    .project-prose :global(.project-flow) {
      margin: 1.75rem 0 2rem;
    }

    .project-prose :global(.project-flow-node) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero-image {
      transition: none;
    }

    section:hover .project-hero-image {
      transform: none;
    }
  }
</style>

<script>
  const projectProse = document.querySelector<HTMLElement>('.project-prose');

  const isStandaloneCodeParagraph = (element: Element | undefined) => {
    if (!element || element.tagName !== 'P' || element.children.length !== 1) return false;

    const child = element.firstElementChild;
    return child?.tagName === 'CODE' && element.textContent?.trim() === child.textContent?.trim();
  };

  const isFlowArrowParagraph = (element: Element | undefined) => {
    if (!element || element.tagName !== 'P') return false;

    return /^[\s\u2190-\u21ff\uFE0E]+$/u.test(element.textContent ?? '');
  };

  if (projectProse && !projectProse.dataset.flowsEnhanced) {
    projectProse.dataset.flowsEnhanced = 'true';
    const contentChildren = Array.from(projectProse.children);

    contentChildren.forEach((element) => {
      if (isFlowArrowParagraph(element)) {
        element.classList.add('project-flow-arrow');
        element.setAttribute('aria-hidden', 'true');
      }
    });

    for (let index = 0; index < contentChildren.length;) {
      if (!isStandaloneCodeParagraph(contentChildren[index])) {
        index += 1;
        continue;
      }

      let end = index;
      let nodeCount = 1;

      while (
        isFlowArrowParagraph(contentChildren[end + 1])
        && isStandaloneCodeParagraph(contentChildren[end + 2])
      ) {
        end += 2;
        nodeCount += 1;
      }

      if (nodeCount < 2) {
        index += 1;
        continue;
      }

      const flow = document.createElement('div');
      flow.className = 'project-flow';
      projectProse.insertBefore(flow, contentChildren[index]);

      for (let current = index; current <= end; current += 1) {
        const element = contentChildren[current];
        if (isStandaloneCodeParagraph(element)) element.classList.add('project-flow-node');
        flow.appendChild(element);
      }

      index = end + 1;
    }
  }

  const projectTocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-project-toc-link]'));
  const projectHeadings = Array.from(document.querySelectorAll<HTMLElement>('.project-prose h2[id]'));

  if (projectTocLinks.length > 0 && projectHeadings.length > 0) {
    let activeProjectSectionId = '';

    const activateProjectSection = (id: string) => {
      if (activeProjectSectionId === id) return;

      activeProjectSectionId = id;
      let activeLink: HTMLAnchorElement | undefined;

      projectTocLinks.forEach((link) => {
        const isActive = link.dataset.projectTocLink === id;
        link.classList.toggle('project-toc-link--active', isActive);

        if (isActive) {
          activeLink = link;
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      activeLink?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    const updateProjectSection = () => {
      const marker = window.scrollY + Math.min(window.innerHeight * 0.3, 260);
      let activeHeading = projectHeadings[0];

      projectHeadings.forEach((heading) => {
        const headingTop = heading.getBoundingClientRect().top + window.scrollY;
        if (headingTop <= marker) activeHeading = heading;
      });

      activateProjectSection(activeHeading.id);
    };

    let updateFrame = 0;
    const scheduleProjectSectionUpdate = () => {
      if (updateFrame) return;

      updateFrame = requestAnimationFrame(() => {
        updateFrame = 0;
        updateProjectSection();
      });
    };

    projectTocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const targetId = link.dataset.projectTocLink;
        if (targetId) activateProjectSection(targetId);
      });
    });

    window.addEventListener('scroll', scheduleProjectSectionUpdate, { passive: true });
    window.addEventListener('resize', scheduleProjectSectionUpdate);
    updateProjectSection();
  }
</script>
