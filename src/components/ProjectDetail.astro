---
import { render } from 'astro:content';
import type { Project } from '../lib/projects';
import { getProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sectionHeadings = headings.filter(({ depth }) => depth === 2);
const projects = await getProjects();
const currentIndex = projects.findIndex(({ id }) => id === project.id);
const relatedProjects = [
  ...projects.slice(currentIndex + 1),
  ...projects.slice(0, currentIndex),
].slice(0, 2);
---

<main class="relative z-10 min-h-screen pb-24 pt-36 md:pt-40">
  <div class="container mx-auto max-w-[1200px] px-6">
    <a href="/proyectos" class="mb-8 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-[var(--color-muted)] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-amber)]">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      Volver a proyectos
    </a>

    <header class="mb-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-end">
      <div>
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-[var(--color-coral)]/30 bg-[var(--color-coral)]/10 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-amber)]">{data.type}</span>
          <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)]">{data.year} · {data.client}</span>
        </div>
        <h1 class="mb-5 max-w-[850px] text-[42px] font-semibold leading-[1.03] tracking-[-0.04em] text-white md:text-[64px]">{data.title}</h1>
        <p class="max-w-[760px] text-lg leading-relaxed text-[var(--color-muted)] md:text-xl">{data.subtitle}</p>
      </div>

      <div class="border-l border-white/10 pl-5">
        <span class="mb-3 block font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Tecnologías principales</span>
        <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${data.title}`}>
          {data.tech.map((technology) => (
            <li class="rounded border border-white/10 bg-white/[0.025] px-2.5 py-1.5 font-mono text-[9px] uppercase tracking-[0.1em] text-white/80">{technology}</li>
          ))}
        </ul>
      </div>
    </header>

    <figure class="command-bar-mockup relative mb-14 aspect-[16/8] overflow-hidden md:mb-16 md:aspect-[16/7]">
      <img src={data.image} alt={data.imageAlt} class="h-full w-full object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-canvas)]/75 via-transparent to-transparent"></div>
      <figcaption class="absolute bottom-5 left-5 rounded-md border border-white/10 bg-[var(--color-canvas)]/70 px-3 py-2 font-mono text-[9px] uppercase tracking-[0.14em] text-white/75 backdrop-blur-md md:bottom-7 md:left-7">
        {data.client} / {data.year}
      </figcaption>
    </figure>

    <div class="grid gap-12 lg:grid-cols-[220px_minmax(0,760px)] lg:justify-between xl:grid-cols-[240px_minmax(0,790px)]">
      <aside>
        <div class="sticky top-32 space-y-8">
          <dl class="grid grid-cols-2 gap-x-4 gap-y-6 border-y border-white/10 py-6 lg:grid-cols-1">
            <div>
              <dt class="mb-1.5 font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Cliente</dt>
              <dd class="text-sm font-medium text-white">{data.client}</dd>
            </div>
            <div>
              <dt class="mb-1.5 font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Tipo de proyecto</dt>
              <dd class="text-sm font-medium text-white">{data.type}</dd>
            </div>
            <div>
              <dt class="mb-1.5 font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Año</dt>
              <dd class="text-sm font-medium text-white">{data.year}</dd>
            </div>
          </dl>

          {sectionHeadings.length > 0 && (
            <nav aria-label="Contenido del proyecto" class="hidden lg:block">
              <span class="mb-4 block font-mono text-[9px] uppercase tracking-[0.15em] text-[var(--color-muted)]">En este proyecto</span>
              <ol class="space-y-3 border-l border-white/10 pl-4">
                {sectionHeadings.map((heading, index) => (
                  <li>
                    <a href={`#${heading.slug}`} class="group flex gap-3 text-xs leading-snug text-[var(--color-muted)] transition-colors hover:text-white">
                      <span class="font-mono text-[9px] text-[var(--color-coral)]">{String(index + 1).padStart(2, '0')}</span>
                      <span>{heading.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          {data.externalUrl && (
            <a href={data.externalUrl} target="_blank" rel="noopener noreferrer" class="keycap-btn w-full justify-center">
              Visitar proyecto
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
            </a>
          )}
        </div>
      </aside>

      <article class="project-prose min-w-0">
        <p class="project-lead">{data.excerpt}</p>
        <Content />
      </article>
    </div>

    <section class="mt-20 border-t border-white/8 pt-12 md:mt-24 md:pt-16" aria-labelledby="siguientes-proyectos-heading">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="mb-3 block font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-amber)]">Continúa explorando</span>
          <h2 id="siguientes-proyectos-heading" class="text-3xl font-semibold tracking-tight text-white">Otros proyectos</h2>
        </div>
        <a href="/proyectos" class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-white">
          Ver colección completa
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {relatedProjects.map((entry) => <ProjectCard project={entry} compact />)}
      </div>
    </section>
  </div>
</main>

<style>
  .project-lead {
    margin: 0 0 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    color: var(--color-white);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .project-prose :global(h2) {
    margin: 3.5rem 0 1.25rem;
    color: var(--color-white);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    scroll-margin-top: 7rem;
  }

  .project-prose :global(h3) {
    margin: 2.25rem 0 0.85rem;
    color: var(--color-white);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .project-prose :global(p) {
    margin: 0 0 1.25rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .project-prose :global(ul),
  .project-prose :global(ol) {
    margin: 1.5rem 0 2rem;
    padding-left: 1.35rem;
    color: var(--color-muted);
  }

  .project-prose :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .project-prose :global(li) {
    position: relative;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .project-prose :global(ul > li::before) {
    content: '';
    position: absolute;
    top: 0.72rem;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-coral);
  }

  .project-prose :global(ol) {
    counter-reset: project-steps;
    list-style: none;
    padding-left: 0;
  }

  .project-prose :global(ol > li) {
    counter-increment: project-steps;
    padding: 1rem 1rem 1rem 3.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }

  .project-prose :global(ol > li::before) {
    content: counter(project-steps, decimal-leading-zero);
    position: absolute;
    top: 1.15rem;
    left: 1rem;
    color: var(--color-coral);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .project-prose :global(strong) {
    color: var(--color-white);
    font-weight: 600;
  }

  .project-prose :global(a) {
    color: var(--color-amber);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-amber) 40%, transparent);
    text-underline-offset: 0.2em;
  }

  .project-prose :global(blockquote) {
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    border-left: 2px solid var(--color-coral);
    border-radius: 0 0.75rem 0.75rem 0;
    background: color-mix(in srgb, var(--color-coral) 7%, transparent);
  }

  .project-prose :global(blockquote p) {
    margin: 0;
    color: var(--color-white);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .project-prose :global(img) {
    width: 100%;
    margin: 2.5rem 0;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.875rem;
  }

  .project-prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
  }

  .project-prose :global(pre) {
    overflow-x: auto;
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-black) 60%, transparent);
  }

  .project-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .project-prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
    border-collapse: collapse;
  }

  .project-prose :global(th),
  .project-prose :global(td) {
    min-width: 10rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
    color: var(--color-muted);
    font-size: 0.9rem;
    text-align: left;
  }

  .project-prose :global(th) {
    color: var(--color-white);
    font-weight: 600;
  }

  @media (max-width: 639px) {
    .project-prose :global(p) {
      font-size: 1rem;
      line-height: 1.8;
    }

    .project-prose :global(blockquote) {
      padding: 1.25rem;
    }
  }
</style>
