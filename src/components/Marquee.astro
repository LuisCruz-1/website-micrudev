---
const services = [
  { name: "SISTEMAS.WEB", status: "ONLINE" },
  { name: "DISEÑO.UX_UI", status: "OPTIMIZED" },
  { name: "APPS.MOVILES", status: "SCALABLE" },
  { name: "E_COMMERCE", status: "SECURE" },
  { name: "CONSULTORIA", status: "ACTIVE" },
  { name: "ARQUITECTURA.CLOUD", status: "DEPLOYED" },
];
---

<div class="w-full overflow-hidden py-8 border-y border-white/10 bg-void relative flex">
  <!-- Fade masks -->
  <div class="absolute left-0 top-0 w-24 h-full bg-gradient-to-r from-void to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 w-24 h-full bg-gradient-to-l from-void to-transparent z-10 pointer-events-none"></div>

  <div class="flex w-max gap-8 animate-[scroll_40s_linear_infinite] hover:[animation-play-state:paused]">
    {/* First set */}
    {services.map(service => (
      <div class="flex items-center gap-4 bg-surface/50 border border-white/5 rounded-full px-6 py-2 backdrop-blur-sm">
        <div class="w-1.5 h-1.5 rounded-full bg-blue-tertiary animate-pulse"></div>
        <span class="font-mono text-sm tracking-widest text-muted">{service.name}</span>
        <span class="font-mono text-[10px] text-blue-primary border border-blue-primary/30 px-2 py-0.5 rounded-full">{service.status}</span>
      </div>
    ))}
    {/* Second set */}
    {services.map(service => (
      <div class="flex items-center gap-4 bg-surface/50 border border-white/5 rounded-full px-6 py-2 backdrop-blur-sm" aria-hidden="true">
        <div class="w-1.5 h-1.5 rounded-full bg-blue-tertiary animate-pulse"></div>
        <span class="font-mono text-sm tracking-widest text-muted">{service.name}</span>
        <span class="font-mono text-[10px] text-blue-primary border border-blue-primary/30 px-2 py-0.5 rounded-full">{service.status}</span>
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 16px));
    }
  }
</style>
