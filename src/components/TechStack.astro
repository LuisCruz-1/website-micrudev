---
export const stackData = [
  { name: 'HTML5', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg' },
  { name: 'CSS3', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg' },
  { name: 'JavaScript', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg' },
  { name: 'Firebase', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/firebase/firebase-original.svg' },
  { name: 'Laravel', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/laravel/laravel-original.svg' },
  { name: 'React', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg' },
  { name: 'Tailwind', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/tailwindcss/tailwindcss-original.svg' },
  { name: 'jQuery', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/jquery/jquery-original.svg' },
  { name: 'Supabase', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/supabase/supabase-original.svg' },
  { name: 'Power Automate', icon: 'https://upload.wikimedia.org/wikipedia/commons/4/4d/Microsoft_Power_Automate.svg' },
  { name: 'Docker', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg' },
  { name: 'WordPress', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/wordpress/wordpress-plain.svg' },
  { name: 'Flutter / FlutterFlow', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/flutter/flutter-original.svg', isWide: true },
  { name: 'Git', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg' },
  { name: 'PHP', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/php/php-original.svg' },
  { name: 'Node.js', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg' },
  { name: 'MySQL', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mysql/mysql-original.svg' },
  { name: 'Postman', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg' },
  { name: 'Photoshop', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/photoshop/photoshop-original.svg' },
  { name: 'Illustrator', icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/illustrator/illustrator-original.svg' },
  { name: 'n8n', icon: 'https://cdn.simpleicons.org/n8n/EA4B71' },
];

const row1 = stackData.slice(0, 11);
const row2 = stackData.slice(11);
const copies = [0, 1, 2];
---

<section id="stack" class="relative z-10 scroll-mt-20 overflow-hidden border-t border-white/5 py-24">
  <div class="container mx-auto mb-14 px-6 text-center">
    <div class="mb-6 inline-flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
      <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--color-muted)]">Tech Stack</span>
    </div>
    <h2 class="text-4xl font-[600] tracking-tight text-white md:text-5xl">
      Tecnologías que <span class="text-warm-gradient">dominamos.</span>
    </h2>
  </div>

  <div id="tecnologias" class="container mx-auto max-w-[1200px] scroll-mt-24 px-6">
    <div class="mx-auto flex w-full flex-col gap-px overflow-hidden border-y border-white/5 bg-white/10 shadow-2xl shadow-black/50 [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="animate-marquee flex w-max gap-px hover:[animation-play-state:paused]" role="list" aria-label="Tecnologías web y de desarrollo">
        {copies.map((copyIndex) => (
          <div class="flex shrink-0 gap-px" aria-hidden={copyIndex === 0 ? undefined : 'true'}>
            {row1.map((tech) => (
              <div
                class={`group relative flex h-[100px] shrink-0 cursor-crosshair flex-col items-center justify-center overflow-hidden bg-[var(--color-canvas)] transition-all duration-300 hover:z-10 hover:bg-white/[0.03] ${tech.isWide ? 'w-[201px] md:w-[241px]' : 'w-[100px] md:w-[120px]'}`}
                role={copyIndex === 0 ? 'listitem' : undefined}
                title={tech.name}
              >
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-coral)_0%,transparent_70%)] opacity-0 transition-opacity duration-500 group-hover:opacity-20"></div>
                <div class="absolute left-0 top-0 h-0.5 w-full -translate-x-full bg-[var(--color-amber)] transition-transform duration-500 ease-out group-hover:translate-x-0"></div>
                <img
                  src={tech.icon}
                  alt=""
                  class={`object-contain opacity-55 grayscale transition-all duration-500 ease-out group-hover:scale-110 group-hover:opacity-100 group-hover:grayscale-0 md:group-hover:-translate-y-3 ${tech.isWide ? 'h-8 md:h-10' : 'h-6 w-6 md:h-8 md:w-8'}`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute bottom-2 w-full translate-y-0 px-2 text-center font-mono text-[8px] uppercase tracking-widest text-[var(--color-muted)] opacity-100 transition-all duration-500 group-hover:text-white md:bottom-3 md:translate-y-4 md:text-[10px] md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100">
                  {tech.name}
                </span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div class="animate-marquee-reverse flex w-max gap-px hover:[animation-play-state:paused]" role="list" aria-label="Tecnologías de infraestructura, diseño y automatización">
        {copies.map((copyIndex) => (
          <div class="flex shrink-0 gap-px" aria-hidden={copyIndex === 0 ? undefined : 'true'}>
            {row2.map((tech) => (
              <div
                class={`group relative flex h-[100px] shrink-0 cursor-crosshair flex-col items-center justify-center overflow-hidden bg-[var(--color-canvas)] transition-all duration-300 hover:z-10 hover:bg-white/[0.03] ${tech.isWide ? 'w-[201px] md:w-[241px]' : 'w-[100px] md:w-[120px]'}`}
                role={copyIndex === 0 ? 'listitem' : undefined}
                title={tech.name}
              >
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-coral)_0%,transparent_70%)] opacity-0 transition-opacity duration-500 group-hover:opacity-20"></div>
                <div class="absolute left-0 top-0 h-0.5 w-full -translate-x-full bg-[var(--color-amber)] transition-transform duration-500 ease-out group-hover:translate-x-0"></div>
                <img
                  src={tech.icon}
                  alt=""
                  class={`object-contain opacity-55 grayscale transition-all duration-500 ease-out group-hover:scale-110 group-hover:opacity-100 group-hover:grayscale-0 md:group-hover:-translate-y-3 ${tech.isWide ? 'h-8 md:h-10' : 'h-6 w-6 md:h-8 md:w-8'}`}
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute bottom-2 w-full translate-y-0 px-2 text-center font-mono text-[8px] uppercase tracking-widest text-[var(--color-muted)] opacity-100 transition-all duration-500 group-hover:text-white md:bottom-3 md:translate-y-4 md:text-[10px] md:opacity-0 md:group-hover:translate-y-0 md:group-hover:opacity-100">
                  {tech.name}
                </span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="mt-4 flex items-center justify-between gap-4 px-2 font-mono text-[9px] uppercase tracking-widest text-[var(--color-muted)] md:px-4 md:text-[10px]">
      <div class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-amber)]"></span>
        <span class="hidden sm:inline">Technology Nodes: {stackData.length}</span>
        <span class="sm:hidden">Nodes: {stackData.length}</span>
      </div>
      <button id="tech-stack-modal-open" type="button" class="group inline-flex min-h-11 items-center gap-2 rounded-lg border border-white/10 bg-white/[0.025] px-3 text-[var(--color-muted)] transition-colors hover:border-[var(--color-coral)]/40 hover:bg-white/[0.05] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-haspopup="dialog" aria-controls="tech-stack-dialog" aria-expanded="false">
        <span class="hidden sm:inline">Ver todas las tecnologías</span>
        <span class="sm:hidden">Ver todas</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:scale-110" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" /></svg>
      </button>
    </div>
  </div>

  <dialog id="tech-stack-dialog" class="tech-dialog" aria-labelledby="tech-stack-dialog-title" aria-describedby="tech-stack-dialog-description">
    <div class="flex max-h-[calc(100dvh-2rem)] flex-col">
      <header class="flex shrink-0 items-center justify-between gap-4 border-b border-white/8 px-4 py-3 md:px-6 md:py-4">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-[var(--color-canvas)] text-[var(--color-amber)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" /></svg>
          </span>
          <div class="min-w-0">
            <span class="block truncate font-mono text-[8px] uppercase tracking-[0.15em] text-[var(--color-muted)]">Micrudev / Technology Nodes</span>
            <h3 id="tech-stack-dialog-title" class="truncate text-base font-semibold text-white md:text-lg">Todas las tecnologías</h3>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-3">
          <span class="hidden font-mono text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)] sm:block">{stackData.length} nodos</span>
          <button id="tech-stack-modal-close" type="button" class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 text-[var(--color-muted)] transition-colors hover:border-[var(--color-coral)]/40 hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-amber)]" aria-label="Cerrar listado de tecnologías">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
          </button>
        </div>
      </header>

      <div class="tech-dialog-content min-h-0 overflow-y-auto px-4 py-5 md:px-6 md:py-6">
        <p id="tech-stack-dialog-description" class="mb-6 max-w-[660px] text-sm leading-relaxed text-[var(--color-muted)]">
          Una vista estática de las herramientas que utilizamos para construir, integrar, automatizar y publicar soluciones digitales.
        </p>

        <div class="mb-2 flex items-center justify-between gap-4 px-1 font-mono text-[8px] uppercase tracking-[0.14em] text-[var(--color-muted)] md:text-[9px]">
          <span class="font-[500] text-[var(--color-amber)]">Stack completo</span>
          <span>{stackData.length} nodos</span>
        </div>

        <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/8 bg-white/10 sm:grid-cols-3 md:grid-cols-5" aria-label="Listado completo de tecnologías">
          {stackData.map((tech) => (
            <li class="tech-modal-card group relative flex min-h-[112px] flex-col items-center justify-center overflow-hidden bg-[var(--color-canvas)] px-3 py-4 text-center">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-coral)_0%,transparent_70%)] opacity-0 transition-opacity duration-500 group-hover:opacity-20"></div>
              <div class="absolute left-0 top-0 h-0.5 w-full -translate-x-full bg-[var(--color-amber)] transition-transform duration-500 ease-out group-hover:translate-x-0"></div>
              <img
                src={tech.icon}
                alt=""
                class={`relative z-10 object-contain opacity-70 grayscale transition-all duration-500 ease-out group-hover:scale-110 group-hover:opacity-100 group-hover:grayscale-0 ${tech.isWide ? 'h-9 max-w-[108px]' : 'h-8 w-8'}`}
                loading="lazy"
                decoding="async"
              />
              <span class="relative z-10 mt-3 font-mono text-[8px] uppercase leading-relaxed tracking-[0.12em] text-[var(--color-muted)] transition-colors group-hover:text-white md:text-[9px]">
                {tech.name}
              </span>
            </li>
          ))}
          <li class="col-span-1 flex min-h-[112px] flex-col items-center justify-center gap-2 bg-white/[0.015] px-4 font-mono text-[8px] uppercase tracking-[0.13em] text-[var(--color-muted)] sm:hidden md:col-span-4 md:flex md:flex-row md:justify-between" aria-hidden="true">
            <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-amber)]"></span>Índice completo</span>
            <span>{stackData.length} / {stackData.length} nodos</span>
          </li>
        </ul>
      </div>

      <footer class="flex shrink-0 items-center justify-between gap-4 border-t border-white/8 bg-white/[0.02] px-4 py-3 font-mono text-[8px] uppercase tracking-[0.13em] text-[var(--color-muted)] md:px-6">
        <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[var(--color-amber)]"></span>Stack indexado</span>
        <span>Grid v1.1</span>
      </footer>
    </div>
  </dialog>
</section>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333333%); }
  }

  @keyframes marquee-reverse {
    from { transform: translateX(-33.333333%); }
    to { transform: translateX(0); }
  }

  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  .animate-marquee-reverse {
    animation: marquee-reverse 30s linear infinite;
  }

  .tech-dialog {
    width: calc(100% - 2rem);
    max-width: 960px;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    color: var(--color-white);
    background: var(--theme-cmd-bg);
    border: 1px solid var(--theme-cmd-border);
    border-radius: 18px;
    box-shadow: 0 40px 120px rgba(2, 8, 28, 0.45), var(--theme-cmd-shadow);
  }

  .tech-dialog[open] {
    animation: tech-dialog-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tech-dialog::backdrop {
    background: rgba(2, 6, 18, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .tech-modal-card {
    transition: background-color 240ms ease;
  }

  .tech-modal-card:hover {
    background: color-mix(in srgb, var(--color-white) 3%, var(--color-canvas));
  }

  .tech-dialog-content {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-white) 24%, transparent) transparent;
  }

  .tech-dialog-content::-webkit-scrollbar {
    width: 8px;
  }

  .tech-dialog-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .tech-dialog-content::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-white) 24%, transparent);
    background-clip: content-box;
    border: 2px solid transparent;
    border-radius: 9999px;
  }

  :global(body.tech-stack-modal-open) {
    overflow: hidden;
  }

  @keyframes tech-dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee,
    .animate-marquee-reverse {
      animation: none;
      transform: none;
    }

    .tech-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  const techStackModalHash = '#tecnologias';
  const techStackDialog = document.querySelector<HTMLDialogElement>('#tech-stack-dialog');
  const openTechStackButton = document.querySelector<HTMLButtonElement>('#tech-stack-modal-open');
  const closeTechStackButton = document.querySelector<HTMLButtonElement>('#tech-stack-modal-close');
  let techStackReturnFocus: HTMLElement | null = null;
  let techStackHashEntry = Boolean(history.state?.techStackDialog);

  function openTechStackDialog() {
    if (!techStackDialog || techStackDialog.open) return;

    techStackReturnFocus = document.activeElement instanceof HTMLElement && document.activeElement !== document.body
      ? document.activeElement
      : openTechStackButton;
    techStackDialog.showModal();
    openTechStackButton?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('tech-stack-modal-open');
    closeTechStackButton?.focus();
  }

  function closeTechStackDialog() {
    if (!techStackDialog?.open) return;

    if (window.location.hash === techStackModalHash && techStackHashEntry) {
      techStackHashEntry = false;
      techStackDialog.close();
      history.back();
      return;
    }

    if (window.location.hash === techStackModalHash) {
      history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
    }

    techStackDialog.close();
  }

  openTechStackButton?.addEventListener('click', () => {
    if (window.location.hash !== techStackModalHash) {
      techStackHashEntry = true;
      history.pushState({ ...(history.state ?? {}), techStackDialog: true }, '', techStackModalHash);
    }

    openTechStackDialog();
  });

  closeTechStackButton?.addEventListener('click', closeTechStackDialog);

  techStackDialog?.addEventListener('click', (event) => {
    const bounds = techStackDialog.getBoundingClientRect();
    const clickedOutside = event.clientX < bounds.left
      || event.clientX > bounds.right
      || event.clientY < bounds.top
      || event.clientY > bounds.bottom;

    if (clickedOutside) closeTechStackDialog();
  });

  techStackDialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeTechStackDialog();
  });

  techStackDialog?.addEventListener('close', () => {
    openTechStackButton?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('tech-stack-modal-open');
    techStackReturnFocus?.focus();
    techStackReturnFocus = null;
  });

  window.addEventListener('hashchange', () => {
    if (window.location.hash === techStackModalHash) {
      techStackHashEntry = Boolean(history.state?.techStackDialog);
      openTechStackDialog();
      return;
    }

    techStackHashEntry = false;
    if (techStackDialog?.open) techStackDialog.close();
  });

  if (window.location.hash === techStackModalHash) openTechStackDialog();
</script>
